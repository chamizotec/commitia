#!/usr/bin/env bash
#
# CommitIA - Gerador de commits inteligentes com IA
# https://github.com/chamizotec/commitia
#
# Gera mensagens de commit seguindo o padrão Conventional Commits
# usando inteligência artificial para analisar suas alterações.
#

set -e

VERSION="1.0.15"
SCRIPT_NAME="commitia"
REPO_URL="https://github.com/chamizotec/commitia"
# COMMITIA_REPO_RAW_URL permite apontar para outra origem (uso avançado e testes)
REPO_RAW_URL="${COMMITIA_REPO_RAW_URL:-https://raw.githubusercontent.com/chamizotec/commitia/main}"

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Configurações padrão (serão aplicadas após carregar o config)
CONFIG_FILE="${HOME}/.commitiarc"
DRY_RUN=false
INTERACTIVE=false
AMEND=false
FORCE_UPDATE=false

# Checagem de nova versão do commitia (valores finais definidos em load_config)
SKIP_UPDATE_CHECK=false
UPDATE_CHECK_INTERVAL_HOURS=24
# Tempo máximo (s) da consulta de versão remota: não pode atrasar o commit offline
UPDATE_CHECK_TIMEOUT=3
# Argumentos originais (para reexecutar o commitia após uma atualização)
ORIG_ARGS=()

# jq disponível? (fallback para grep/sed quando não instalado)
HAS_JQ=false
command -v jq &>/dev/null && HAS_JQ=true

# Output bruto do provedor de IA (para log em caso de erro)
COMMITIA_RAW_OUTPUT=""
# Saída de erro do git commit quando o commit falha (hooks, validação, etc.)
COMMITIA_COMMIT_STDERR=""

# ----------------------------------------------------------------------------
# Arquivos grandes (lockfiles e diffs muito grandes)
# ----------------------------------------------------------------------------

# Padrões (glob, separados por espaço/vírgula) de lockfiles conhecidos.
# Casam com o nome do arquivo (basename) ou com o caminho completo.
DEFAULT_LOCKFILE_PATTERNS="pnpm-lock.yaml package-lock.json npm-shrinkwrap.json yarn.lock bun.lock bun.lockb composer.lock Cargo.lock poetry.lock Pipfile.lock Gemfile.lock go.sum mix.lock pubspec.lock Podfile.lock Package.resolved flake.lock packages.lock.json deno.lock uv.lock pdm.lock gradle.lockfile *.lock *-lock.json *-lock.yaml *.lockb"

# Arquivos grandes e pequenos detectados no stage (arrays paralelos para os grandes)
LARGE_FILES=()
LARGE_REASONS=()
LARGE_BINARY=()
SMALL_FILES=()

# Escopo atual: caminhos considerados na geração da mensagem e no commit.
# Vazio = todo o stage (comportamento padrão).
SCOPE_PATHS=()
SCOPE_SPECS=()

# Modo do "diff" enviado à IA: full (diff real) ou summary (resumo reduzido)
DIFF_MODE="full"
DIFF_TRUNCATE=false
COMMITIA_SUMMARY=""

# Estado da "sessão" (execução atual do commitia)
SESSION_LAST_COMMIT=""
SESSION_LAST_INFO=""
SESSION_LAST_LABEL=""
SESSION_LOGS=()

# Arquivos grandes retirados temporariamente do stage (restaurados em caso de falha)
PENDING_FILES=()
SAVED_TREE=""
GIT_ROOT=""

# Origem da mensagem gerada: ia, resumo ou minimo
MSG_SOURCE="ia"
GROUP_HINT=""

# ============================================================================
# Log de erros
# ============================================================================

# Retorna o diretório de logs (.commitia/logs na raiz do repo ou ~/.commitia/logs)
get_log_dir() {
  local git_root
  git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$git_root" ]; then
    echo "$git_root/.commitia/logs"
  else
    echo "${HOME}/.commitia/logs"
  fi
}

# Cria o diretório de logs e, se ele estiver dentro do repositório e não for
# ignorado, adiciona .commitia/ ao .git/info/exclude (evita commitar logs sem querer)
prepare_log_dir() {
  local dir="$1"
  mkdir -p "$dir"

  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -n "$root" ] || return 0
  case "$dir" in
    "$root"/*) ;;
    *) return 0 ;;
  esac

  if ! git check-ignore -q -- "$dir/commitia-error.log" 2>/dev/null; then
    local exclude_file
    exclude_file=$(git rev-parse --git-path info/exclude 2>/dev/null)
    if [ -n "$exclude_file" ]; then
      mkdir -p "$(dirname "$exclude_file")" 2>/dev/null || true
      printf '\n# CommitIA (logs locais)\n.commitia/\n' >> "$exclude_file" 2>/dev/null || true
    fi
  fi
  return 0
}

# Gera um caminho de log único (várias falhas no mesmo segundo não se sobrescrevem)
unique_log_path() {
  local log_dir="$1"
  local base="${log_dir}/commitia-error-$(date +%Y%m%d-%H%M%S)"
  local candidate="${base}.log"
  local n=1
  while [ -e "$candidate" ]; do
    candidate="${base}-${n}.log"
    n=$((n + 1))
  done
  echo "$candidate"
}

# Cria o diretório de logs e grava arquivo com informações do erro
write_error_log() {
  local raw_output="$1"
  local prompt="$2"
  local diff_content="$3"
  local staged_files="$4"
  local branch="$5"
  
  local log_dir
  log_dir=$(get_log_dir)
  prepare_log_dir "$log_dir"
  
  local log_file
  log_file=$(unique_log_path "$log_dir")
  
  {
    echo "=============================================="
    echo "CommitIA - Log de erro na geração do commit"
    echo "=============================================="
    echo "Data/Hora: $(date -Iseconds 2>/dev/null || date)"
    echo "Provedor:  $AI_PROVIDER"
    echo "Branch:    ${branch:- (não em repo git)}"
    echo ""
    echo "--- Arquivos no stage ---"
    echo "$staged_files"
    echo ""
    echo "--- Prompt enviado (início) ---"
    echo "${prompt:0:2000}"
    [ ${#prompt} -gt 2000 ] && echo "... [truncado]"
    echo ""
    echo "--- Diff (staged) ---"
    echo "${diff_content:0:4000}"
    [ ${#diff_content} -gt 4000 ] && echo "... [truncado]"
    echo ""
    echo "--- Resposta bruta do provedor de IA ---"
    echo "$raw_output"
    echo ""
    echo "--- Fim do log ---"
  } > "$log_file"
  
  echo "$log_file"
}

# Grava log quando o commit é rejeitado (ex.: commitlint, husky, hooks)
write_commit_failure_log() {
  local commit_msg="$1"
  local git_stderr="$2"
  local staged_files="$3"
  local branch="$4"
  
  local log_dir
  log_dir=$(get_log_dir)
  prepare_log_dir "$log_dir"
  
  local log_file
  log_file=$(unique_log_path "$log_dir")
  
  {
    echo "=============================================="
    echo "CommitIA - Log de erro: falha ao realizar commit"
    echo "=============================================="
    echo "Data/Hora: $(date -Iseconds 2>/dev/null || date)"
    echo "Provedor:  $AI_PROVIDER"
    echo "Branch:    ${branch:- (não em repo git)}"
    echo ""
    echo "--- Mensagem de commit tentada ---"
    echo "$commit_msg"
    echo ""
    echo "--- Arquivos no stage ---"
    echo "$staged_files"
    echo ""
    echo "--- Saída de erro do git commit ---"
    echo "$git_stderr"
    echo ""
    echo "--- Fim do log ---"
  } > "$log_file"
  
  echo "$log_file"
}

# Remove os arquivos de log da pasta de logs (após commit bem-sucedido).
# Preserva os logs de falhas intermediárias da IA gerados nesta execução
# (SESSION_LOGS), por exemplo quando o fallback resolveu a mensagem.
clear_error_logs() {
  local log_dir f s keep
  log_dir=$(get_log_dir)
  [ -d "$log_dir" ] || return 0

  for f in "$log_dir"/commitia-error-*.log; do
    [ -e "$f" ] || continue
    keep=false
    for s in "${SESSION_LOGS[@]}"; do
      if [ "$s" = "$f" ]; then keep=true; fi
    done
    if [ "$keep" = false ]; then rm -f "$f" 2>/dev/null || true; fi
  done
  return 0
}

# ============================================================================
# Funções de utilidade
# ============================================================================

# Escapa string para uso dentro de JSON (quando jq não está disponível)
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# Extrai campo de texto de respostas JSON (fallback quando sem jq)
# Uso: parse_json_response "$response" "content"  ou "text" ou "response"
# Limitação: mensagens com aspas duplas podem ser cortadas; use jq para conteúdo complexo
parse_json_response() {
  local response="$1"
  local field="$2"
  # Remove prefixo até "field":", depois remove ", ou "} e o restante (fim do valor JSON)
  echo "$response" | sed "s/.*\"${field}\"[[:space:]]*:[[:space:]]*\"//" | \
    sed 's/"[[:space:]]*,[[:space:]]*.*$//; s/"[[:space:]]*}.*$//; s/"[[:space:]]*$//' | \
    sed 's/\\n/\n/g' | sed 's/\\"/"/g'
}

print_banner() {
  echo -e "${PURPLE}"
  echo '   ____                          _ _   ___    _    '
  echo '  / ___|___  _ __ ___  _ __ ___ (_) |_|_ _|  / \   '
  echo ' | |   / _ \| '\''_ ` _ \| '\''_ ` _ \| | __|| |  / _ \  '
  echo ' | |__| (_) | | | | | | | | | | | | |_ | | / ___ \ '
  echo '  \____\___/|_| |_| |_|_| |_| |_|_|\__|___/_/   \_\'
  echo -e "${NC}"
  echo -e "${CYAN}  Commits inteligentes com IA - v${VERSION}${NC}"
  echo ""
}

print_help() {
  print_banner
  echo -e "${BOLD}USO:${NC}"
  echo "  $SCRIPT_NAME [opções] [arquivos...]"
  echo "  $SCRIPT_NAME skill [destino] [opções]   Cria uma skill para agentes de IA (veja SKILL)"
  echo ""
  echo -e "${BOLD}OPÇÕES:${NC}"
  echo "  -m, --message <texto>    Contexto adicional para a mensagem de commit"
  echo "  -t, --type <tipo>        Força um tipo específico de commit"
  echo "  -s, --scope <escopo>     Define o escopo manualmente"
  echo "  -i, --interactive        Modo interativo (confirma antes de commitar)"
  echo "  -d, --dry-run            Apenas mostra a mensagem sem fazer commit"
  echo "  -a, --amend              Altera o último commit"
  echo "  --no-stage               Não adiciona arquivos ao stage automaticamente"
  echo "  --provider <provider>    Define o provedor de IA (amp, openai, gemini, ollama, cursor, copilot, claude, codex, gemini-cli)"
  echo "  --lang <idioma>          Idioma da mensagem (pt, en, es)"
  echo "  --update                 Atualiza para a versão mais recente"
  echo "  --force                  Força atualização (usar com --update)"
  echo "  -v, --version            Mostra a versão"
  echo "  -h, --help               Mostra esta ajuda"
  echo ""
  echo -e "${BOLD}EXEMPLOS:${NC}"
  echo "  $SCRIPT_NAME                        # Commit de todas as alterações"
  echo "  $SCRIPT_NAME src/                   # Commit apenas da pasta src/"
  echo "  $SCRIPT_NAME -m \"corrige bug X\"     # Com contexto adicional"
  echo "  $SCRIPT_NAME -t fix -s auth         # Força tipo 'fix' com escopo 'auth'"
  echo "  $SCRIPT_NAME -i                     # Modo interativo"
  echo "  $SCRIPT_NAME -d                     # Dry-run (apenas mostra a mensagem)"
  echo ""
  echo -e "${BOLD}TIPOS DE COMMIT:${NC}"
  echo "  feat      Nova funcionalidade"
  echo "  fix       Correção de bug"
  echo "  docs      Documentação"
  echo "  style     Formatação, ponto-e-vírgula, etc."
  echo "  refactor  Refatoração de código"
  echo "  test      Adição ou correção de testes"
  echo "  chore     Tarefas de manutenção"
  echo "  perf      Melhorias de performance"
  echo "  ci        Alterações de CI/CD"
  echo "  build     Sistema de build ou dependências"
  echo "  revert    Reversão de commit anterior"
  echo ""
  echo -e "${BOLD}CONFIGURAÇÃO:${NC}"
  echo "  Arquivos de configuração (ordem de prioridade):"
  echo "    1. .commitiarc na raiz do projeto (maior prioridade)"
  echo "    2. ~/.commitiarc (global)"
  echo ""
  echo "  Variáveis disponíveis:"
  echo "    - COMMITIA_PROVIDER: amp, openai, gemini, ollama, cursor, copilot, claude, codex, gemini-cli (padrão: amp)"
  echo "    - COMMITIA_CLI_TIMEOUT: tempo máximo em segundos das CLIs de IA (padrão: 120)"
  echo "    - COMMITIA_<CLI>_MODEL: modelo opcional (CURSOR, COPILOT, CLAUDE, CODEX, GEMINI_CLI)"
  echo "    - COMMITIA_SKIP_CLI_VERSION_CHECK: true pula a validação de versão das CLIs (padrão: false)"
  echo "    - COMMITIA_SKIP_UPDATE_CHECK: true desliga o aviso de nova versão do commitia (padrão: false)"
  echo "    - COMMITIA_UPDATE_CHECK_INTERVAL_HOURS: intervalo mínimo entre consultas de versão, em horas (padrão: 24; 0 = sempre)"
  echo "    - COMMITIA_LANGUAGE: pt, en, es (padrão: pt)"
  echo "    - COMMITIA_AUTO_STAGE: true, false (padrão: true)"
  echo "    - COMMITIA_LARGE_FILES: true, false - trata arquivos grandes em commits separados (padrão: true)"
  echo "    - COMMITIA_LARGE_FILE_LINES: linhas alteradas para considerar um arquivo grande (padrão: 1000; 0 desativa)"
  echo "    - COMMITIA_LARGE_FILE_BYTES: bytes do diff/binário para considerar grande (padrão: 100000; 0 desativa)"
  echo "    - COMMITIA_LARGE_FILE_PATTERNS: globs de arquivos sempre grandes, ex.: lockfiles (padrão: lista de lockfiles)"
  echo ""
  echo -e "${BOLD}ATUALIZAÇÕES:${NC}"
  echo "  Antes de commitar, o commitia consulta (no máx. 1x por dia, com timeout de 3s e sem erro offline)"
  echo "  se há versão mais nova. Em terminal interativo pergunta 'Deseja atualizar agora? [S/n]'; se sim,"
  echo "  atualiza e continua o commit com a versão nova. Sem terminal interativo ou com --dry-run apenas"
  echo "  informa (nada é alterado). Com uma CLI de IA desatualizada, também oferece atualizá-la."
  echo ""
  echo -e "${BOLD}SKILL PARA AGENTES DE IA:${NC}"
  echo "  $SCRIPT_NAME skill <cursor|vscode|copilot|claude|file> [--global]"
  echo "  Gera uma skill que ensina agentes de IA a usar o commitia para commitar."
  echo "  Em 'file' apenas gera o arquivo para você incluir onde preferir. Veja: $SCRIPT_NAME skill --help"
  echo ""
  echo -e "${BOLD}ARQUIVOS GRANDES:${NC}"
  echo "  Lockfiles (pnpm-lock.yaml, package-lock.json, yarn.lock...) e arquivos com diff muito grande"
  echo "  são commitados separadamente: primeiro os pequenos, depois cada arquivo grande. Se a IA falhar"
  echo "  com o diff completo, o commitia envia só nome, linhas alteradas e contexto resumido (mais o"
  echo "  último commit da sessão, se houver) e, em último caso, usa uma mensagem padrão. Sem commit na"
  echo "  sessão, vai direto para a mensagem padrão. Com --amend não há separação."
  echo ""
  echo -e "${BOLD}.COMMITIAIGNORE:${NC}"
  echo "  Arquivo opcional na raiz do repositório. ATENÇÃO: a semântica é DIFERENTE da do .gitignore"
  echo "  (o Git não ignora nada; o arquivo só controla o que o commitia adiciona e envia à IA)."
  echo "  Uma entrada por linha; linhas vazias e comentários (#) são ignorados; aceita globs (*.lock, dir/**)."
  echo "    +package-lock.json   É commitado normalmente, mas o diff NÃO é enviado à IA"
  echo "    .env.local           NÃO é adicionado automaticamente pelo commitia (git add); só entra no"
  echo "                         commit se você já o tiver colocado no stage (git add) antes"
  echo "  Arquivo staged manualmente e sem prefixo: entra no commit e o diff vai à IA (escolha sua),"
  echo "  salvo se casar também com uma entrada '+'. Os dois eixos (commit x IA) são independentes."
  echo ""
}

print_version() {
  echo "CommitIA v${VERSION}"
}

error() {
  echo -e "${RED}✗ Erro: $1${NC}" >&2
  exit 1
}

warn() {
  echo -e "${YELLOW}⚠ Aviso: $1${NC}" >&2
}

success() {
  echo -e "${GREEN}✓ $1${NC}"
}

info() {
  echo -e "${BLUE}ℹ $1${NC}"
}

# stdin e stdout são um terminal? (COMMITIA_TEST_FORCE_TTY=true só para os testes,
# que simulam o terminal com stdin em pipe)
is_interactive_terminal() {
  [ "${COMMITIA_TEST_FORCE_TTY:-}" = "true" ] && return 0
  [ -t 0 ] && [ -t 1 ]
}

# Pergunta "[S/n]" e lê uma linha. Retorna 0 para sim (Enter também é sim) e
# 1 para não. Fim da entrada (EOF) sem resposta conta como não.
ask_yes_no() {
  local response=""
  echo -e "${YELLOW}$1 [S/n]${NC}"
  read -r response || [ -n "$response" ] || response="n"
  case "$response" in
    [Nn]*) return 1 ;;
    *) return 0 ;;
  esac
}

# ============================================================================
# Validações
# ============================================================================

# ----------------------------------------------------------------------------
# Validação de versão das CLIs de IA (cursor, copilot, claude, codex, gemini-cli)
#
# A verificação é por CAPACIDADE: o '--help' da CLI precisa listar as flags que o
# commitia usa. Não há versão mínima fixa, pois não dá para determiná-la com
# segurança para todas as CLIs (a versão instalada é mostrada só para diagnóstico).
# ----------------------------------------------------------------------------

# Cache da execução atual (o provedor é único por execução)
CLI_HELP_LOADED=false
CLI_HELP_CACHE=""
CLI_VERSION_CACHE=""
CLI_MISSING_FLAGS=""

# Define os dados da CLI do provedor atual (CLI_BIN, CLI_HELP_ARGS,
# CLI_REQUIRED_FLAGS, CLI_UPDATE_CMD para exibir, CLI_UPDATE_RUN para executar).
# Retorna 1 se o provedor não usa CLI.
load_cli_spec() {
  case "$AI_PROVIDER" in
    cursor)
      CLI_BIN="cursor-agent"
      CLI_HELP_ARGS="--help"
      CLI_REQUIRED_FLAGS="--print --output-format --mode"
      CLI_UPDATE_CMD="cursor-agent update"
      CLI_UPDATE_RUN="cursor-agent update"
      ;;
    copilot)
      CLI_BIN="copilot"
      CLI_HELP_ARGS="--help"
      CLI_REQUIRED_FLAGS="--prompt --silent --no-color --no-ask-user --no-custom-instructions --no-auto-update --disable-builtin-mcps --deny-tool"
      CLI_UPDATE_CMD="npm install -g @github/copilot@latest  (ou: copilot update)"
      CLI_UPDATE_RUN="npm install -g @github/copilot@latest"
      ;;
    claude)
      CLI_BIN="claude"
      CLI_HELP_ARGS="--help"
      CLI_REQUIRED_FLAGS="--print --tools --disable-slash-commands --strict-mcp-config --no-session-persistence --output-format"
      CLI_UPDATE_CMD="npm install -g @anthropic-ai/claude-code@latest  (ou: claude update)"
      CLI_UPDATE_RUN="npm install -g @anthropic-ai/claude-code@latest"
      ;;
    codex)
      CLI_BIN="codex"
      CLI_HELP_ARGS="exec --help"
      CLI_REQUIRED_FLAGS="--skip-git-repo-check --ephemeral --sandbox --color --output-last-message"
      CLI_UPDATE_CMD="npm install -g @openai/codex@latest  (ou: codex update)"
      CLI_UPDATE_RUN="npm install -g @openai/codex@latest"
      ;;
    gemini-cli)
      CLI_BIN="gemini"
      CLI_HELP_ARGS="--help"
      CLI_REQUIRED_FLAGS="--approval-mode --skip-trust --output-format --prompt"
      CLI_UPDATE_CMD="npm install -g @google/gemini-cli@latest"
      CLI_UPDATE_RUN="npm install -g @google/gemini-cli@latest"
      ;;
    *)
      return 1
      ;;
  esac
  return 0
}

# Executa um comando rápido (--help/--version) com timeout curto, se disponível
run_quick() {
  if command -v timeout &>/dev/null; then
    timeout 15 "$@"
  elif command -v gtimeout &>/dev/null; then
    gtimeout 15 "$@"
  else
    "$@"
  fi
}

# Lê o '--help' da CLI uma única vez por execução (cache em CLI_HELP_CACHE)
get_cli_help() {
  [ "$CLI_HELP_LOADED" = true ] && return 0
  CLI_HELP_LOADED=true
  # shellcheck disable=SC2086
  CLI_HELP_CACHE=$(run_quick "$CLI_BIN" $CLI_HELP_ARGS 2>&1 </dev/null || true)
}

# Lê a versão instalada (só para diagnóstico); cache em CLI_VERSION_CACHE
get_cli_version() {
  [ -n "$CLI_VERSION_CACHE" ] && return 0
  local v
  v=$(run_quick "$CLI_BIN" --version 2>&1 </dev/null | head -1 | \
    grep -oE '[0-9]+(\.[0-9]+)+[0-9A-Za-z._-]*' | head -1 || true)
  v="${v%%[.-]}"
  CLI_VERSION_CACHE="${v:-desconhecida}"
}

# Preenche CLI_MISSING_FLAGS com as flags exigidas que o '--help' não lista.
# Se o '--help' não puder ser lido, não bloqueia (não dá para afirmar nada).
find_missing_cli_flags() {
  CLI_MISSING_FLAGS=""
  get_cli_help
  [ -z "$CLI_HELP_CACHE" ] && return 0

  local flag
  for flag in $CLI_REQUIRED_FLAGS; do
    if ! printf '%s\n' "$CLI_HELP_CACHE" | grep -Eq -- "(^|[^[:alnum:]-])${flag}([^[:alnum:]-]|$)"; then
      CLI_MISSING_FLAGS="${CLI_MISSING_FLAGS:+$CLI_MISSING_FLAGS }$flag"
    fi
  done
}

# A saída bruta indica flag/opção não reconhecida (CLI desatualizada)?
is_cli_outdated_output() {
  printf '%s\n' "$1" | grep -Eiq \
    "(unknown|unrecognized|unrecognised|invalid|unsupported|unexpected) (option|flag|argument|arguments|subcommand|command)|no such option|did you mean --|unexpected argument"
}

# Exibe a mensagem "CLI precisa ser atualizada" (em stderr).
# $1: flags ausentes detectadas pelo --help (pode ser vazio)
# $2: saída bruta da CLI (opcional; usada para extrair a flag reclamada)
print_cli_outdated() {
  local missing="$1" raw="$2"
  local what="$missing"

  if [ -z "$what" ] && [ -n "$raw" ]; then
    what=$(printf '%s\n' "$raw" | grep -oE -e '--[a-z][a-z0-9-]*' | head -1 || true)
  fi
  get_cli_version

  echo "" >&2
  echo -e "${RED}✗ Erro: a CLI '$CLI_BIN' precisa ser atualizada${NC}" >&2
  echo -e "  Versão instalada:  ${BOLD}${CLI_VERSION_CACHE}${NC}" >&2
  echo -e "  Não suportado:     ${BOLD}${what:-flags exigidas pelo commitia}${NC}" >&2
  echo -e "  Atualize com:      ${BOLD}${CLI_UPDATE_CMD}${NC}" >&2
  echo -e "  Ou use outro provedor: ${BOLD}$SCRIPT_NAME --provider <provedor>${NC}" >&2
}

# Em terminal interativo, oferece atualizar a CLI desatualizada (CLI_UPDATE_RUN).
# Retorna 0 se a atualização rodou com sucesso (caches do --help limpos para
# revalidar) e 1 se não houve atualização (modo não interativo, --dry-run,
# recusa ou falha); nesse caso o chamador aborta com a mensagem de atualização.
offer_cli_update() {
  # Não interativo ou --dry-run: não altera nada nem pergunta
  is_interactive_terminal || return 1
  [ "$DRY_RUN" = true ] && return 1

  local -a update_cmd
  read -ra update_cmd <<< "$CLI_UPDATE_RUN"
  [ ${#update_cmd[@]} -gt 0 ] || return 1
  if ! command -v "${update_cmd[0]}" &>/dev/null; then
    warn "'${update_cmd[0]}' não encontrado; não é possível atualizar a CLI automaticamente"
    return 1
  fi

  echo "" >&2
  warn "A CLI '$CLI_BIN' está desatualizada (não suporta: $CLI_MISSING_FLAGS)"
  if ! ask_yes_no "Deseja atualizar agora? (${CLI_UPDATE_RUN})"; then
    return 1
  fi

  info "Executando: ${CLI_UPDATE_RUN}"
  if ! "${update_cmd[@]}"; then
    warn "A atualização da CLI '$CLI_BIN' falhou"
    return 1
  fi

  # Revalida: o --help e a versão precisam ser lidos de novo
  hash -r 2>/dev/null || true
  CLI_HELP_LOADED=false
  CLI_HELP_CACHE=""
  CLI_VERSION_CACHE=""
  success "CLI '$CLI_BIN' atualizada; revalidando..."
  return 0
}

# Validação preventiva: aborta antes de gerar a mensagem se a CLI estiver desatualizada
# (em terminal interativo, antes oferece atualizar a CLI e continua se der certo)
check_cli_version() {
  [ "$SKIP_CLI_VERSION_CHECK" = true ] && return 0
  load_cli_spec || return 0

  find_missing_cli_flags
  if [ -n "$CLI_MISSING_FLAGS" ] && offer_cli_update; then
    find_missing_cli_flags
    if [ -n "$CLI_MISSING_FLAGS" ]; then
      warn "Mesmo após atualizar, a CLI '$CLI_BIN' ainda não suporta: $CLI_MISSING_FLAGS"
    fi
  fi
  if [ -n "$CLI_MISSING_FLAGS" ]; then
    print_cli_outdated "$CLI_MISSING_FLAGS" ""
    echo -e "  Para pular esta checagem: COMMITIA_SKIP_CLI_VERSION_CHECK=true" >&2
    exit 1
  fi
}

# Rede de segurança em tempo de execução: se a falha da IA foi por flag
# desconhecida, mostra a mensagem de atualização (o log já foi gravado).
# Retorna 0 se tratou o erro como CLI desatualizada.
report_cli_outdated_failure() {
  load_cli_spec || return 1
  is_cli_outdated_output "$COMMITIA_RAW_OUTPUT" || return 1

  find_missing_cli_flags
  print_cli_outdated "$CLI_MISSING_FLAGS" "$COMMITIA_RAW_OUTPUT"
  echo -e "  Log gravado em:    ${BOLD}$LOG_PATH${NC}" >&2
  echo -e "  Se a CLI já estiver atualizada, consulte o log para ver o erro original." >&2
  return 0
}

check_dependencies() {
  # Verifica se está em um repositório git
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    error "Não está em um repositório Git"
  fi

  # Verifica o provedor de IA
  case "$AI_PROVIDER" in
    amp)
      if ! command -v amp &>/dev/null; then
        error "amp CLI não encontrado. Instale em: https://ampcode.com"
      fi
      ;;
    openai)
      if [ -z "$OPENAI_API_KEY" ]; then
        error "OPENAI_API_KEY não definida"
      fi
      if ! command -v curl &>/dev/null; then
        error "curl não encontrado"
      fi
      if [ "$HAS_JQ" = false ]; then
        warn "jq não encontrado; usando grep/sed (recomendado: brew install jq)"
      fi
      ;;
    ollama)
      if ! command -v ollama &>/dev/null; then
        error "Ollama não encontrado. Instale em: https://ollama.ai"
      fi
      if [ "$HAS_JQ" = false ]; then
        warn "jq não encontrado; usando grep/sed (recomendado: brew install jq)"
      fi
      ;;
    gemini)
      if [ -z "$GEMINI_API_KEY" ]; then
        error "GEMINI_API_KEY não definida. Obtenha em: https://aistudio.google.com/apikey"
      fi
      if ! command -v curl &>/dev/null; then
        error "curl não encontrado"
      fi
      if [ "$HAS_JQ" = false ]; then
        warn "jq não encontrado; usando grep/sed (recomendado: brew install jq)"
      fi
      ;;
    cursor)
      if ! command -v cursor-agent &>/dev/null; then
        error "cursor-agent não encontrado. Instale com: curl https://cursor.com/install -fsS | bash"
      fi
      ;;
    copilot)
      if ! command -v copilot &>/dev/null; then
        error "copilot CLI não encontrado. Instale com: npm install -g @github/copilot"
      fi
      ;;
    claude)
      if ! command -v claude &>/dev/null; then
        error "claude CLI não encontrado. Instale com: npm install -g @anthropic-ai/claude-code"
      fi
      ;;
    codex)
      if ! command -v codex &>/dev/null; then
        error "codex CLI não encontrado. Instale com: npm install -g @openai/codex"
      fi
      ;;
    gemini-cli)
      if ! command -v gemini &>/dev/null; then
        error "gemini CLI não encontrado. Instale com: npm install -g @google/gemini-cli"
      fi
      ;;
    *)
      error "Provedor de IA desconhecido: $AI_PROVIDER"
      ;;
  esac

  # Provedores baseados em CLI: valida se a versão instalada suporta as flags usadas
  check_cli_version
}

check_staged_changes() {
  if [ -z "$(git diff --staged --name-only)" ]; then
    return 1
  fi
  return 0
}

check_unstaged_changes() {
  if [ -z "$(git diff --name-only)" ] && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    return 1
  fi
  return 0
}

# ============================================================================
# Atualização
# ============================================================================

# --- Funções reutilizáveis (nunca chamam exit e não definem traps) ------------

# Versão no formato numérico X.Y.Z (aceita sufixo, ex.: 1.0.16-beta)
is_valid_version() {
  [[ "$1" =~ ^[0-9]+(\.[0-9]+)*([-+._][0-9A-Za-z._-]*)?$ ]]
}

# Compara versões semanticamente (numérico por componente): retorna 0 se $1 > $2.
# Sufixos de pré-release (-beta) são ignorados; componentes ausentes valem 0.
version_gt() {
  local IFS=.
  local -a a b
  read -ra a <<< "$1"
  read -ra b <<< "$2"
  local i n=${#a[@]} x y
  [ ${#b[@]} -gt "$n" ] && n=${#b[@]}
  for ((i = 0; i < n; i++)); do
    x="${a[i]:-0}"; x="${x%%[!0-9]*}"; x=$((10#${x:-0}))
    y="${b[i]:-0}"; y="${y%%[!0-9]*}"; y=$((10#${y:-0}))
    if [ "$x" -gt "$y" ]; then return 0; fi
    if [ "$x" -lt "$y" ]; then return 1; fi
  done
  return 1
}

# Resolve o caminho absoluto de um arquivo, seguindo symlinks
resolve_path() {
  local p="$1" link dir
  while [ -L "$p" ]; do
    link=$(readlink "$p")
    case "$link" in
      /*) p="$link" ;;
      *) p="$(dirname "$p")/$link" ;;
    esac
  done
  dir=$(cd "$(dirname "$p")" 2>/dev/null && pwd -P) || return 1
  echo "$dir/$(basename "$p")"
}

# Extrai a versão (VERSION="x.y.z") de um script commitia
extract_script_version() {
  grep -m1 '^VERSION=' "$1" 2>/dev/null | cut -d'"' -f2
}

# Baixa o script remoto (mesma fonte para --update e para a checagem automática).
# $1: arquivo de destino; $2: tempo máximo em segundos (opcional).
download_remote_script() {
  local dest="$1" max_time="${2:-}"
  local -a opts=(-fsSL)
  [ -n "$max_time" ] && opts+=(--connect-timeout "$max_time" --max-time "$max_time")
  curl "${opts[@]}" "$REPO_RAW_URL/bin/commitia" -o "$dest" 2>/dev/null
}

# Instala o script em $2 de forma atômica (cópia ao lado + mv): o arquivo
# antigo só é trocado se a cópia completa deu certo, e o bash em execução
# (que lê o script aos poucos) continua com o arquivo antigo.
# Retorna 1 em caso de falha, sem alterar o destino.
install_script() {
  local src="$1" dest="$2" tmp_dest
  tmp_dest="${dest}.new.$$"
  mkdir -p "$(dirname "$dest")" 2>/dev/null || true
  if cp "$src" "$tmp_dest" 2>/dev/null && chmod +x "$tmp_dest" 2>/dev/null \
    && mv -f "$tmp_dest" "$dest" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp_dest" 2>/dev/null || true
  return 1
}

# Baixa e instala a versão remota em $1, sem prompts e sem exit.
# Retorna 0 se atualizou; 1 se falhou (mensagem via warn). A versão
# instalada fica em UPDATE_INSTALLED_VERSION.
apply_self_update() {
  local dest="$1" temp_dir remote_script remote_version rc=0
  UPDATE_INSTALLED_VERSION=""

  if ! command -v curl &>/dev/null; then
    warn "curl é necessário para atualizar"
    return 1
  fi
  temp_dir=$(mktemp -d) || return 1
  remote_script="$temp_dir/commitia"

  if ! download_remote_script "$remote_script" 60; then
    warn "Não foi possível baixar a nova versão. Verifique sua conexão."
    rc=1
  else
    remote_version=$(extract_script_version "$remote_script")
    if ! is_valid_version "$remote_version" || ! bash -n "$remote_script" 2>/dev/null; then
      warn "O arquivo baixado não é um commitia válido; a atualização foi cancelada"
      rc=1
    elif ! install_script "$remote_script" "$dest"; then
      warn "Não foi possível gravar em $dest. Verifique as permissões."
      rc=1
    else
      UPDATE_INSTALLED_VERSION="$remote_version"
    fi
  fi

  rm -rf "$temp_dir"
  return $rc
}

# --- Atualização manual (--update) ---------------------------------------------

do_update() {
  print_banner
  info "Verificando atualizações..."
  
  # Verifica se curl está disponível
  if ! command -v curl &>/dev/null; then
    error "curl é necessário para atualização. Instale o curl primeiro."
  fi
  
  # Cria diretório temporário (este caminho sempre termina com exit)
  local temp_dir
  temp_dir=$(mktemp -d)
  trap "rm -rf $temp_dir" EXIT
  
  # Baixa a versão remota para verificar
  info "Baixando informações da versão mais recente..."
  local remote_script="$temp_dir/commitia"
  
  if ! download_remote_script "$remote_script"; then
    error "Não foi possível conectar ao repositório. Verifique sua conexão."
  fi
  
  # Extrai versão remota
  local remote_version
  remote_version=$(extract_script_version "$remote_script")
  
  if [ -z "$remote_version" ]; then
    error "Não foi possível determinar a versão remota"
  fi
  
  echo ""
  echo -e "  Versão atual:  ${YELLOW}${VERSION}${NC}"
  echo -e "  Versão remota: ${GREEN}$remote_version${NC}"
  echo ""
  
  # Compara versões
  if [ "$VERSION" = "$remote_version" ] && [ "$FORCE_UPDATE" = false ]; then
    success "Você já está na versão mais recente!"
    echo ""
    info "Use --force para reinstalar mesmo assim"
    exit 0
  fi
  
  # Mensagem apropriada
  if [ "$VERSION" = "$remote_version" ]; then
    echo -e "${YELLOW}Reinstalar a mesma versão $remote_version? [S/n]${NC}"
  else
    echo -e "${YELLOW}Deseja atualizar para a versão $remote_version? [S/n]${NC}"
  fi
  read -r -n 1 response
  echo ""
  
  if [[ $response =~ ^[Nn]$ ]]; then
    info "Atualização cancelada"
    exit 0
  fi
  
  # Determina o diretório de instalação
  local current_script
  current_script=$(command -v commitia 2>/dev/null || echo "$HOME/.local/bin/commitia")
  
  # Instala a nova versão (atômico: o script atual só é trocado se a cópia deu certo)
  info "Instalando versão $remote_version..."
  
  if install_script "$remote_script" "$current_script"; then
    success "Atualizado com sucesso para a versão $remote_version!"
    echo ""
    echo -e "${CYAN}Novidades: ${REPO_URL}/releases${NC}"
  else
    error "Não foi possível atualizar. Verifique as permissões."
  fi
}

# --- Checagem automática de nova versão (antes de commitar) --------------------

update_cache_file() {
  echo "${HOME}/.commitia/update-check"
}

# Lê o cache (UC_VERSION = última versão remota conhecida; UC_NEXT = epoch da
# próxima consulta permitida). Nunca faz source do arquivo.
read_update_cache() {
  UC_VERSION=""
  UC_NEXT=0
  local f line
  f=$(update_cache_file)
  [ -f "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      remote_version=*) UC_VERSION="${line#remote_version=}" ;;
      next_check=*) UC_NEXT="${line#next_check=}" ;;
    esac
  done < "$f"
  is_valid_version "$UC_VERSION" || UC_VERSION=""
  case "$UC_NEXT" in
    ''|*[!0-9]*) UC_NEXT=0 ;;
  esac
  return 0
}

# Grava o cache (falhas de escrita são ignoradas). $1: versão; $2: próxima consulta (epoch)
write_update_cache() {
  local f tmp
  f=$(update_cache_file)
  mkdir -p "$(dirname "$f")" 2>/dev/null || return 0
  tmp="${f}.$$"
  if printf 'remote_version=%s\nnext_check=%s\n' "$1" "$2" > "$tmp" 2>/dev/null; then
    mv -f "$tmp" "$f" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true
  else
    rm -f "$tmp" 2>/dev/null || true
  fi
  return 0
}

# Consulta a versão remota com timeout curto e em silêncio. Imprime a versão
# ou retorna 1 em qualquer falha (sem rede, timeout, resposta inválida).
fetch_remote_version() {
  command -v curl &>/dev/null || return 1
  local body version
  body=$(curl -fsSL --connect-timeout "$UPDATE_CHECK_TIMEOUT" --max-time "$UPDATE_CHECK_TIMEOUT" \
    "$REPO_RAW_URL/bin/commitia" 2>/dev/null) || return 1
  version=$(grep -m1 '^VERSION=' <<< "$body" | cut -d'"' -f2)
  is_valid_version "$version" || return 1
  echo "$version"
}

# Última versão remota conhecida: usa o cache enquanto válido (intervalo em horas);
# senão consulta a rede. Em falha de rede mantém a versão em cache e só tenta de
# novo depois de no máx. 1h (offline não paga a espera do timeout a cada commit).
# Imprime a versão (pode ser vazia) e sempre retorna 0.
get_latest_version() {
  local now interval_secs next version
  now=$(date +%s)
  interval_secs=$((UPDATE_CHECK_INTERVAL_HOURS * 3600))
  read_update_cache

  if [ "$interval_secs" -gt 0 ] && [ "$now" -lt "$UC_NEXT" ] && [ -n "$UC_VERSION" ]; then
    echo "$UC_VERSION"
    return 0
  fi

  # Falha recente (sem versão em cache): também respeita o intervalo de retry
  if [ "$interval_secs" -gt 0 ] && [ "$now" -lt "$UC_NEXT" ]; then
    return 0
  fi

  if version=$(fetch_remote_version); then
    write_update_cache "$version" $((now + interval_secs))
    echo "$version"
  else
    next=$((now + 3600))
    [ "$interval_secs" -gt 0 ] && [ "$interval_secs" -lt 3600 ] && next=$((now + interval_secs))
    [ "$interval_secs" -eq 0 ] && next=$now
    write_update_cache "$UC_VERSION" "$next"
    [ -n "$UC_VERSION" ] && echo "$UC_VERSION"
  fi
  return 0
}

# Verifica se há versão mais nova do commitia antes de commitar. Nunca bloqueia:
# falhas de rede são silenciosas e falhas de atualização seguem com a versão atual.
# Se o usuário aceitar atualizar, reexecuta o commitia novo com os mesmos argumentos.
check_self_update() {
  [ "$SKIP_UPDATE_CHECK" = true ] && return 0
  # Já reexecutado após atualização: evita loop de reexecução
  [ "${COMMITIA_UPDATED_REEXEC:-}" = "1" ] && return 0
  # Fora de um repositório Git o fluxo aborta de qualquer forma
  git rev-parse --is-inside-work-tree &>/dev/null || return 0

  local latest
  latest=$(get_latest_version) || return 0
  [ -n "$latest" ] || return 0
  version_gt "$latest" "$VERSION" || return 0

  echo ""
  info "Nova versão $latest disponível (você está na $VERSION)"

  # --dry-run não altera nada: só informa
  if [ "$DRY_RUN" = true ]; then
    info "Modo --dry-run: o commitia não será atualizado. Para atualizar: $SCRIPT_NAME --update"
    echo ""
    return 0
  fi

  # Sem terminal interativo (pipe/CI): só informa e segue
  if ! is_interactive_terminal; then
    info "Para atualizar: $SCRIPT_NAME --update (ou defina COMMITIA_SKIP_UPDATE_CHECK=true para silenciar)"
    echo ""
    return 0
  fi

  # Atualiza o próprio script em execução; clone de desenvolvimento não é sobrescrito
  local self_path
  self_path=$(resolve_path "${BASH_SOURCE[0]}") || self_path=""
  if [ -z "$self_path" ] || [ -e "$(dirname "$self_path")/../.git" ]; then
    info "Executando a partir de um clone do repositório; atualize com git pull ou $SCRIPT_NAME --update"
    echo ""
    return 0
  fi

  if ! ask_yes_no "Deseja atualizar agora?"; then
    info "Seguindo com a versão atual ($VERSION)"
    echo ""
    return 0
  fi

  info "Atualizando para a versão $latest..."
  if ! apply_self_update "$self_path"; then
    warn "A atualização falhou; seguindo com a versão atual ($VERSION)"
    echo ""
    return 0
  fi
  success "Atualizado para a versão ${UPDATE_INSTALLED_VERSION}! Continuando o commit com a versão nova..."
  echo ""

  # Reexecuta o commitia atualizado (proteção contra loop via variável de ambiente)
  export COMMITIA_UPDATED_REEXEC=1
  shopt -s execfail
  exec "$self_path" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
  # Só chega aqui se o exec falhar: segue com esta execução
  warn "Não foi possível reiniciar o commitia atualizado; seguindo com a versão atual"
  return 0
}

# ============================================================================
# Carrega configuração
# ============================================================================

load_config() {
  # Prioridade de configuração:
  # 1. Valores padrão (menor prioridade)
  # 2. ~/.commitiarc (global)
  # 3. .commitiarc na raiz do projeto (local)
  # 4. Linha de comando (maior prioridade)
  
  # Carrega configuração global se existir
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
  fi
  
  # Carrega configuração local do projeto (sobrescreve global)
  local project_config
  project_config=$(get_project_config_file)
  
  if [ -n "$project_config" ] && [ -f "$project_config" ]; then
    info "Usando configuração do projeto: $project_config"
    # shellcheck source=/dev/null
    source "$project_config"
  fi
  
  # Aplica valores padrão APÓS carregar os configs
  # Se não foi definido via linha de comando, usa config ou default
  AI_PROVIDER="${CLI_PROVIDER:-${COMMITIA_PROVIDER:-amp}}"
  LANGUAGE="${CLI_LANGUAGE:-${COMMITIA_LANGUAGE:-pt}}"
  AUTO_STAGE="${CLI_AUTO_STAGE:-${COMMITIA_AUTO_STAGE:-true}}"
  SKIP_CLI_VERSION_CHECK="${COMMITIA_SKIP_CLI_VERSION_CHECK:-false}"
  SKIP_UPDATE_CHECK="${COMMITIA_SKIP_UPDATE_CHECK:-false}"
  UPDATE_CHECK_INTERVAL_HOURS=$(normalize_int "${COMMITIA_UPDATE_CHECK_INTERVAL_HOURS:-24}" 24 "COMMITIA_UPDATE_CHECK_INTERVAL_HOURS")

  # Arquivos grandes (lockfiles e diffs muito grandes)
  LARGE_FILES_ENABLED="${COMMITIA_LARGE_FILES:-true}"
  LARGE_FILE_LINES=$(normalize_int "${COMMITIA_LARGE_FILE_LINES:-1000}" 1000 "COMMITIA_LARGE_FILE_LINES")
  LARGE_FILE_BYTES=$(normalize_int "${COMMITIA_LARGE_FILE_BYTES:-100000}" 100000 "COMMITIA_LARGE_FILE_BYTES")
  LARGE_FILE_PATTERNS="${COMMITIA_LARGE_FILE_PATTERNS-$DEFAULT_LOCKFILE_PATTERNS}"
}

# Valida inteiro não negativo; usa o padrão (com aviso) se o valor for inválido
normalize_int() {
  local value="$1" default="$2" name="$3"
  case "$value" in
    ''|*[!0-9]*)
      warn "$name inválido ('$value'); usando o padrão $default" >&2
      echo "$default"
      ;;
    *) echo "$value" ;;
  esac
}

# Encontra o arquivo de configuração do projeto (na raiz do repositório Git)
get_project_config_file() {
  local git_root
  git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  
  if [ -n "$git_root" ] && [ -f "$git_root/.commitiarc" ]; then
    echo "$git_root/.commitiarc"
  fi
}

# ============================================================================
# .commitiaignore (na raiz do repositório)
#
# ATENÇÃO: a semântica é DIFERENTE da do .gitignore. O arquivo NÃO faz o Git
# ignorar nada; ele controla o que o commitia adiciona ao commit e o que ele
# envia à IA. Uma entrada por linha (linhas vazias e '#' são ignoradas):
#
#   +padrao   o arquivo É commitado normalmente, mas seu diff NÃO vai para a IA.
#   padrao    o arquivo NÃO é adicionado automaticamente pelo commitia (git add);
#             só entra no commit se você já o tiver colocado no stage (git add).
#             Nesse caso o diff vai à IA normalmente (escolha explícita sua).
#
# Os dois eixos são independentes: se o arquivo casa com '+' e sem prefixo, ele
# não é adicionado automaticamente E, se for staged manualmente, o diff não vai
# à IA (vale sempre a regra mais restritiva em cada eixo).
#
# Padrões (glob estilo .gitignore): '*', '?', '[abc]', '**', '/' no início ou no
# meio ancora na raiz do repositório, '/' no fim casa só diretórios, sem '/' casa
# o nome em qualquer pasta, '\' escapa. Negação ('!') não é suportada.
# O módulo é mantido neste arquivo (e não em um lib/ separado) porque o instalador
# e o --update distribuem somente bin/commitia.
# ============================================================================

IGNORE_FILE_NAME=".commitiaignore"

# Regexes (ERE) das entradas: sem prefixo (não adicionar automaticamente) e '+' (fora da IA)
IGNORE_MANUAL_RES=()
IGNORE_NOAI_RES=()
# Arquivos que o stage automático pulou por causa de entradas sem prefixo
IGNORE_SKIPPED=()
# Arquivos staged (no escopo atual) cujo conteúdo não vai à IA
AI_EXCLUDED_FILES=()
# Pathspecs do diff enviado à IA (escopo + exclusões); vazio = 'git diff --staged' puro
DIFF_SPECS=()

# Converte um glob estilo .gitignore em regex ERE que casa com caminhos relativos
# à raiz do repositório (o arquivo ou qualquer coisa dentro de uma pasta casada).
ignore_glob_to_regex() {
  local pat="$1" anchored=false dir_only=false
  local re="" i=0 n c next j k start neg cls rest after

  case "$pat" in */) dir_only=true; pat="${pat%/}" ;; esac
  case "$pat" in /*) anchored=true; pat="${pat#/}" ;; esac
  case "$pat" in */*) anchored=true ;; esac

  n=${#pat}
  while [ "$i" -lt "$n" ]; do
    c="${pat:$i:1}"
    case "$c" in
      '*')
        if [ "${pat:$((i + 1)):1}" = "*" ]; then
          j=$((i + 2))
          while [ "${pat:$j:1}" = "*" ]; do j=$((j + 1)); done
          # '**' só é especial como componente inteiro ('**/x', 'x/**', 'x/**/y')
          if [ "$i" -eq 0 ] || [ "${pat:$((i - 1)):1}" = "/" ]; then
            if [ "$j" -ge "$n" ]; then
              re+='.*'; i=$j; continue
            elif [ "${pat:$j:1}" = "/" ]; then
              re+='(.*/)?'; i=$((j + 1)); continue
            fi
          fi
          re+='[^/]*'; i=$j
        else
          re+='[^/]*'; i=$((i + 1))
        fi
        ;;
      '?')
        re+='[^/]'; i=$((i + 1))
        ;;
      '[')
        k=$((i + 1)); neg=""
        case "${pat:$k:1}" in '!'|'^') neg='^'; k=$((k + 1)) ;; esac
        start=$k
        [ "${pat:$k:1}" = "]" ] && k=$((k + 1))
        while [ "$k" -lt "$n" ] && [ "${pat:$k:1}" != "]" ]; do
          # classes POSIX ([:alpha:]) dentro do colchete
          if [ "${pat:$k:2}" = "[:" ]; then
            rest="${pat:$k}"
            after="${rest#*:]}"
            if [ "$after" != "$rest" ]; then
              k=$((n - ${#after}))
              continue
            fi
          fi
          k=$((k + 1))
        done
        if [ "$k" -ge "$n" ]; then
          re+='\['; i=$((i + 1))   # sem ']' de fechamento: '[' literal
        else
          cls="${pat:$start:$((k - start))}"
          re+="[${neg}${cls}]"; i=$((k + 1))
        fi
        ;;
      '\')
        next="${pat:$((i + 1)):1}"
        if [ -z "$next" ]; then
          re+='\\'; i=$((i + 1))
        else
          case "$next" in
            '.'|'^'|'$'|'+'|'('|')'|'{'|'}'|'|'|'['|']'|'\'|'*'|'?') re+="\\$next" ;;
            *) re+="$next" ;;
          esac
          i=$((i + 2))
        fi
        ;;
      '.'|'^'|'$'|'+'|'('|')'|'{'|'}'|'|'|']')
        re+="\\$c"; i=$((i + 1))
        ;;
      *)
        re+="$c"; i=$((i + 1))
        ;;
    esac
  done

  local prefix="" suffix='(/.*)?'
  [ "$anchored" = true ] || prefix='(.*/)?'
  [ "$dir_only" = true ] && suffix='/.*'
  printf '%s' "^${prefix}${re}${suffix}\$"
}

# Lê um .commitiaignore e preenche IGNORE_MANUAL_RES / IGNORE_NOAI_RES.
# Linhas vazias e comentários ('#') são ignorados; '+' marca "fora da IA".
parse_ignore_file() {
  local file="$1" line pat kind lineno=0
  IGNORE_MANUAL_RES=()
  IGNORE_NOAI_RES=()

  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    case "$line" in \#*) continue ;; esac

    kind="manual"
    pat="$line"
    case "$line" in
      '+'*)
        kind="noai"
        pat="${line#+}"
        pat="${pat#"${pat%%[![:space:]]*}"}"
        ;;
      '!'*)
        warn "$IGNORE_FILE_NAME linha $lineno: negação ('!') não é suportada; linha ignorada: $line"
        continue
        ;;
    esac
    if [ -z "$pat" ]; then
      warn "$IGNORE_FILE_NAME linha $lineno: '+' sem padrão; linha ignorada"
      continue
    fi

    if [ "$kind" = "noai" ]; then
      IGNORE_NOAI_RES+=("$(ignore_glob_to_regex "$pat")")
    else
      IGNORE_MANUAL_RES+=("$(ignore_glob_to_regex "$pat")")
    fi
  done < "$file"
  return 0
}

# Carrega o .commitiaignore da raiz do repositório (ausente = sem regras, sem erro)
load_ignore_rules() {
  IGNORE_MANUAL_RES=()
  IGNORE_NOAI_RES=()

  local root file total
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -n "$root" ] || return 0
  file="$root/$IGNORE_FILE_NAME"
  { [ -f "$file" ] && [ -r "$file" ]; } || return 0

  parse_ignore_file "$file"
  total=$(( ${#IGNORE_MANUAL_RES[@]} + ${#IGNORE_NOAI_RES[@]} ))
  if [ "$total" -gt 0 ]; then
    info "Usando $IGNORE_FILE_NAME do projeto: $total regra(s) (${#IGNORE_NOAI_RES[@]} com '+', ${#IGNORE_MANUAL_RES[@]} sem prefixo)"
  fi
  return 0
}

# O caminho casa com algum dos regexes ($2...)?
ignore_match_any() {
  local path="$1" re
  shift
  for re in "$@"; do
    if [[ "$path" =~ $re ]]; then return 0; fi
  done
  return 1
}

# Entrada sem prefixo: não adicionar automaticamente (só entra se já estiver staged)
is_manual_only_path() {
  [ ${#IGNORE_MANUAL_RES[@]} -gt 0 ] || return 1
  ignore_match_any "$1" "${IGNORE_MANUAL_RES[@]}"
}

# Entrada com '+': commitado normalmente, mas o diff não é enviado à IA
is_ai_excluded_path() {
  [ ${#IGNORE_NOAI_RES[@]} -gt 0 ] || return 1
  ignore_match_any "$1" "${IGNORE_NOAI_RES[@]}"
}

# $1 está na lista ($2...)?
ignore_array_contains() {
  local needle="$1" x
  shift
  for x in "$@"; do
    if [ "$x" = "$needle" ]; then return 0; fi
  done
  return 1
}

# Lista (separada por NUL) os arquivos staged do escopo atual
list_staged_z() {
  if [ ${#SCOPE_SPECS[@]} -gt 0 ]; then
    git diff --staged --name-only -z --no-renames -- "${SCOPE_SPECS[@]}" 2>/dev/null
  else
    git diff --staged --name-only -z --no-renames 2>/dev/null
  fi
}

# Preenche AI_EXCLUDED_FILES com os arquivos staged (no escopo atual) casando com '+'
collect_ai_excluded_files() {
  AI_EXCLUDED_FILES=()
  [ ${#IGNORE_NOAI_RES[@]} -gt 0 ] || return 0
  local f
  while IFS= read -r -d '' f; do
    if is_ai_excluded_path "$f"; then AI_EXCLUDED_FILES+=("$f"); fi
  done < <(list_staged_z)
  return 0
}

# Monta DIFF_SPECS: escopo atual + exclusão (literal) dos arquivos '+' staged.
# Sem arquivos '+' no stage, DIFF_SPECS = escopo (ou vazio): comportamento original.
build_diff_specs() {
  DIFF_SPECS=()
  collect_ai_excluded_files
  if [ ${#SCOPE_SPECS[@]} -gt 0 ]; then
    DIFF_SPECS=("${SCOPE_SPECS[@]}")
  elif [ ${#AI_EXCLUDED_FILES[@]} -gt 0 ]; then
    DIFF_SPECS=(":/")
  fi
  local f
  for f in ${AI_EXCLUDED_FILES[@]+"${AI_EXCLUDED_FILES[@]}"}; do
    DIFF_SPECS+=(":(top,exclude,literal)$f")
  done
  return 0
}

# Nota anexada ao diff: lista (só os nomes) dos arquivos do commit cujo conteúdo foi omitido
print_ai_omitted_note() {
  [ ${#AI_EXCLUDED_FILES[@]} -gt 0 ] || return 0
  local list="" f
  for f in "${AI_EXCLUDED_FILES[@]}"; do
    list="${list:+$list, }$f"
  done
  printf '\n[Nota: estes arquivos também fazem parte deste commit, mas o conteúdo foi omitido por configuração do usuário (%s): %s. Não tente ler nem inferir o conteúdo deles.]\n' "$IGNORE_FILE_NAME" "$list"
  return 0
}

# Todos os arquivos staged do grupo atual são '+' (nada a enviar à IA)?
staged_group_fully_ai_excluded() {
  [ ${#IGNORE_NOAI_RES[@]} -gt 0 ] || return 1
  local f total=0 excluded=0
  while IFS= read -r -d '' f; do
    total=$((total + 1))
    if is_ai_excluded_path "$f"; then excluded=$((excluded + 1)); fi
  done < <(list_staged_z)
  [ "$total" -gt 0 ] && [ "$total" -eq "$excluded" ]
}

# Adiciona alterações ao stage respeitando o .commitiaignore.
# Sem argumentos equivale a 'git add .'; com argumentos, a 'git add <args>'.
#  - Sem entradas sem prefixo, roda exatamente o 'git add' original.
#  - Arquivos que casam com entrada sem prefixo NÃO são adicionados (ficam em
#    IGNORE_SKIPPED), exceto os já staged (o stage manual é preservado: nunca
#    são re-adicionados nem removidos) e os passados explicitamente como arquivo
#    na linha de comando (escolha explícita, equivale a um 'git add' manual).
stage_changes() {
  IGNORE_SKIPPED=()
  if [ ${#IGNORE_MANUAL_RES[@]} -eq 0 ]; then
    if [ $# -eq 0 ]; then git add .; else git add "$@"; fi
    return 0
  fi

  local a f
  local -a explicit=() specs=() staged=() to_add=()
  if [ $# -eq 0 ]; then
    specs=(.)
  else
    for a in "$@"; do
      if [ -d "$a" ]; then specs+=("$a"); else explicit+=("$a"); fi
    done
  fi

  if [ ${#explicit[@]} -gt 0 ]; then git add "${explicit[@]}"; fi
  [ ${#specs[@]} -gt 0 ] || return 0

  while IFS= read -r -d '' f; do
    staged+=("$f")
  done < <(git diff --staged --name-only -z --no-renames 2>/dev/null)

  # modificados, deletados e novos (não ignorados pelo .gitignore) sob os pathspecs
  while IFS= read -r -d '' f; do
    if is_manual_only_path "$f"; then
      if ! ignore_array_contains "$f" ${staged[@]+"${staged[@]}"}; then
        IGNORE_SKIPPED+=("$f")
      fi
      continue
    fi
    to_add+=(":(top,literal)$f")
  done < <(git ls-files -z --full-name --modified --others --deleted --exclude-standard -- "${specs[@]}" 2>/dev/null | sort -zu)

  local n=${#to_add[@]} k=0
  while [ "$k" -lt "$n" ]; do
    git add -- "${to_add[@]:$k:200}"
    k=$((k + 200))
  done
  return 0
}

# ============================================================================
# Extração de informações
# ============================================================================

get_task_id_from_branch() {
  local branch
  branch=$(git branch --show-current 2>/dev/null || echo "")
  
  if [ -n "$branch" ]; then
    # Padrões comuns: ENP-1234, JIRA-123, feature/ABC-999, etc.
    echo "$branch" | grep -oE '[A-Z]+-?[0-9]+' | head -1
  fi
}

# Monta os pathspecs literais (relativos à raiz do repo) do escopo atual
set_scope() {
  SCOPE_PATHS=("$@")
  SCOPE_SPECS=()
  local f
  for f in "$@"; do
    SCOPE_SPECS+=(":(top,literal)$f")
  done
}

clear_scope() {
  SCOPE_PATHS=()
  SCOPE_SPECS=()
}

# Diff staged (do escopo atual, se houver). No modo "summary" devolve o resumo
# reduzido em vez do diff completo. Com DIFF_TRUNCATE=true respeita
# COMMITIA_MAX_DIFF_CHARS.
get_staged_diff() {
  if [ "$DIFF_MODE" = "summary" ]; then
    printf '%s\n' "$COMMITIA_SUMMARY"
    return 0
  fi

  # Escopo atual + exclusão dos arquivos '+' do .commitiaignore (conteúdo não vai à IA)
  build_diff_specs

  if [ "$DIFF_TRUNCATE" = true ]; then
    local out
    if [ ${#DIFF_SPECS[@]} -gt 0 ]; then
      out=$(git diff --staged -- "${DIFF_SPECS[@]}" | head -c $((COMMITIA_MAX_DIFF_CHARS + 1)))
    else
      out=$(git diff --staged | head -c $((COMMITIA_MAX_DIFF_CHARS + 1)))
    fi
    if [ ${#out} -gt "$COMMITIA_MAX_DIFF_CHARS" ]; then
      out="${out:0:$COMMITIA_MAX_DIFF_CHARS}"$'\n'"... [diff truncado]"
    fi
    printf '%s\n' "$out"
  elif [ ${#DIFF_SPECS[@]} -gt 0 ]; then
    git diff --staged -- "${DIFF_SPECS[@]}"
  else
    git diff --staged
  fi
  print_ai_omitted_note
}

get_staged_files() {
  if [ ${#SCOPE_SPECS[@]} -gt 0 ]; then
    git diff --staged --name-only -- "${SCOPE_SPECS[@]}"
  else
    git diff --staged --name-only
  fi
}

# ============================================================================
# Geração de mensagem com IA
# ============================================================================

build_prompt() {
  local task_id="$1"
  local context="$2"
  local forced_type="$3"
  local forced_scope="$4"
  local lang="$5"
  local mode="${6:-full}"
  
  local lang_text
  case "$lang" in
    pt) lang_text="em português" ;;
    en) lang_text="in English" ;;
    es) lang_text="en español" ;;
    *) lang_text="em português" ;;
  esac
  
  local scope_text
  if [ -n "$forced_scope" ]; then
    scope_text="Use '$forced_scope' como escopo."
  elif [ -n "$task_id" ]; then
    scope_text="Use '$task_id' como escopo."
  else
    scope_text="Determine o escopo baseado nos arquivos alterados."
  fi
  
  local type_text
  if [ -n "$forced_type" ]; then
    type_text="Use o tipo '$forced_type'."
  else
    type_text="Tipos permitidos: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert."
  fi
  
  local prompt
  if [ "$mode" = "summary" ]; then
    # Fallback: o diff completo não é enviado, apenas um resumo da alteração
    prompt="Gere uma mensagem de commit $lang_text no formato 'tipo(escopo): descrição' com base no RESUMO da alteração fornecido (o diff completo é grande demais e não está disponível). NÃO execute comandos e NÃO leia arquivos. Use o último commit apenas como contexto de estilo e escopo, sem copiar a mensagem dele. $type_text $scope_text A descrição deve ser curta, começar com minúscula e não terminar com ponto."
  else
    prompt="Analise 'git diff --staged' e gere uma mensagem de commit $lang_text no formato 'tipo(escopo): descrição'. $type_text $scope_text A descrição deve ser curta, começar com minúscula e não terminar com ponto."
  fi
  
  if [ -n "$context" ]; then
    prompt="$prompt Contexto adicional: \"$context\"."
  fi
  
  prompt="$prompt Retorne APENAS a mensagem no formato correto, sem explicações ou texto adicional."
  
  echo "$prompt"
}

generate_with_amp() {
  local prompt="$1"

  # Em arquivos grandes (escopo restrito ou resumo) o conteúdo vai no próprio prompt,
  # pois o amp executaria 'git diff --staged' sobre todo o stage
  # O mesmo vale quando há arquivos '+' do .commitiaignore no stage (o amp não pode ver o diff deles)
  build_diff_specs
  if [ "$DIFF_MODE" = "summary" ] || [ ${#SCOPE_SPECS[@]} -gt 0 ] || [ ${#AI_EXCLUDED_FILES[@]} -gt 0 ]; then
    prompt="${prompt}"$'\n\n'"Conteúdo a analisar (use somente isto; NÃO execute comandos):"$'\n'"$(get_staged_diff)"
  fi

  echo "$prompt" | amp -x --dangerously-allow-all 2>&1
}

# ----------------------------------------------------------------------------
# Provedores baseados em CLIs de IA (cursor, copilot, claude, codex, gemini-cli)
#
# O diff é enviado no prompt e as ferramentas dos agentes ficam desligadas
# (somente leitura / sem permissões). Nenhuma flag "allow all" é usada.
# ----------------------------------------------------------------------------

# Tempo máximo (segundos) de espera por uma CLI de IA
COMMITIA_CLI_TIMEOUT="${COMMITIA_CLI_TIMEOUT:-120}"
# Tamanho máximo (caracteres) do diff enviado às CLIs de IA
COMMITIA_MAX_DIFF_CHARS="${COMMITIA_MAX_DIFF_CHARS:-60000}"

# Executa um comando com timeout (se timeout/gtimeout existir no sistema)
run_with_timeout() {
  if command -v timeout &>/dev/null; then
    timeout "$COMMITIA_CLI_TIMEOUT" "$@"
  elif command -v gtimeout &>/dev/null; then
    gtimeout "$COMMITIA_CLI_TIMEOUT" "$@"
  else
    "$@"
  fi
}

# Monta o prompt completo (instruções + diff) para as CLIs de IA
build_cli_prompt() {
  local prompt="$1"
  local diff
  diff=$(get_staged_diff)

  if [ ${#diff} -gt "$COMMITIA_MAX_DIFF_CHARS" ]; then
    diff="${diff:0:$COMMITIA_MAX_DIFF_CHARS}"$'\n'"... [diff truncado]"
  fi

  if [ "$DIFF_MODE" = "summary" ]; then
    printf '%s\n\nO resumo das alterações já está abaixo. NÃO execute comandos, NÃO leia arquivos e NÃO edite nada.\n\nResumo:\n%s\n' "$prompt" "$diff"
  else
    printf '%s\n\nO diff das alterações já está abaixo. NÃO execute comandos, NÃO leia arquivos e NÃO edite nada.\n\nDiff:\n%s\n' "$prompt" "$diff"
  fi
}

generate_with_cursor() {
  local full_prompt
  full_prompt=$(build_cli_prompt "$1")

  # --mode ask: somente leitura (sem edições nem comandos)
  local args=(-p --mode ask --output-format text)
  [ -n "$COMMITIA_CURSOR_MODEL" ] && args+=(--model "$COMMITIA_CURSOR_MODEL")

  run_with_timeout cursor-agent "${args[@]}" "$full_prompt" 2>&1 </dev/null || true
}

generate_with_copilot() {
  local full_prompt
  full_prompt=$(build_cli_prompt "$1")

  # -s: apenas a resposta; --deny-tool: bloqueia shell e escrita de arquivos
  local args=(-s --no-color --no-ask-user --no-custom-instructions --no-auto-update
    --disable-builtin-mcps --deny-tool=shell --deny-tool=write)
  [ -n "$COMMITIA_COPILOT_MODEL" ] && args+=(--model "$COMMITIA_COPILOT_MODEL")

  run_with_timeout copilot "${args[@]}" -p "$full_prompt" 2>&1 </dev/null || true
}

generate_with_claude() {
  local full_prompt
  full_prompt=$(build_cli_prompt "$1")

  # --tools "": nenhuma ferramenta disponível
  local args=(-p --tools "" --disable-slash-commands --strict-mcp-config
    --no-session-persistence --output-format text)
  [ -n "$COMMITIA_CLAUDE_MODEL" ] && args+=(--model "$COMMITIA_CLAUDE_MODEL")

  printf '%s' "$full_prompt" | run_with_timeout claude "${args[@]}" 2>&1 || true
}

generate_with_codex() {
  local full_prompt
  full_prompt=$(build_cli_prompt "$1")

  # -o: grava somente a última mensagem do agente (evita logs/banners do stderr)
  local out_file out
  out_file=$(mktemp)

  local args=(exec --skip-git-repo-check --ephemeral --sandbox read-only --color never
    -o "$out_file")
  [ -n "$COMMITIA_CODEX_MODEL" ] && args+=(--model "$COMMITIA_CODEX_MODEL")

  out=$(printf '%s' "$full_prompt" | run_with_timeout codex "${args[@]}" - 2>&1) || true

  if [ -s "$out_file" ]; then
    cat "$out_file"
  else
    # Falha: devolve só o final da saída (erro) para o log
    echo "$out" | tail -n 20
  fi
  rm -f "$out_file"
}

generate_with_gemini_cli() {
  local full_prompt
  full_prompt=$(build_cli_prompt "$1")

  # --approval-mode plan: somente leitura; o prompt completo vai via stdin
  # --skip-trust: necessário no modo headless em pastas ainda não confiáveis
  local args=(--approval-mode plan --skip-trust -o text)
  [ -n "$COMMITIA_GEMINI_CLI_MODEL" ] && args+=(--model "$COMMITIA_GEMINI_CLI_MODEL")

  printf '%s' "$full_prompt" | run_with_timeout gemini "${args[@]}" \
    -p "Responda APENAS com a mensagem de commit pedida acima, sem explicações." 2>&1 || true
}

generate_with_openai() {
  local prompt="$1"
  local diff
  diff=$(get_staged_diff)
  
  local user_content="${prompt}"$'\n\n'"Diff:"$'\n'"${diff}"
  local sys_content="Você é um assistente especializado em gerar mensagens de commit seguindo Conventional Commits."
  
  local json_payload
  if [ "$HAS_JQ" = true ]; then
    json_payload=$(jq -n \
      --arg prompt "$prompt" \
      --arg diff "$diff" \
      '{
        model: "gpt-4o-mini",
        messages: [
          {role: "system", content: "Você é um assistente especializado em gerar mensagens de commit seguindo Conventional Commits."},
          {role: "user", content: ($prompt + "\n\nDiff:\n" + $diff)}
        ],
        temperature: 0.3
      }')
  else
    json_payload=$(printf '{"model":"gpt-4o-mini","messages":[{"role":"system","content":"%s"},{"role":"user","content":"%s"}],"temperature":0.3}' \
      "$(json_escape "$sys_content")" \
      "$(json_escape "$user_content")")
  fi
  
  local response
  response=$(curl -s https://api.openai.com/v1/chat/completions \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $OPENAI_API_KEY" \
    -d "$json_payload")
  
  if [ "$HAS_JQ" = true ]; then
    echo "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null
  else
    parse_json_response "$response" "content"
  fi
}

generate_with_gemini() {
  local prompt="$1"
  local diff
  diff=$(get_staged_diff)
  
  # API Gemini: https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
  local model="${COMMITIA_GEMINI_MODEL:-gemini-2.0-flash}"
  local text_content="${prompt}"$'\n\n'"Diff:"$'\n'"${diff}"
  
  local json_payload
  if [ "$HAS_JQ" = true ]; then
    json_payload=$(jq -n \
      --arg prompt "$prompt" \
      --arg diff "$diff" \
      '{
        contents: [{ parts: [{ text: ($prompt + "\n\nDiff:\n" + $diff) }] }],
        generationConfig: { temperature: 0.3, maxOutputTokens: 256 }
      }')
  else
    json_payload=$(printf '{"contents":[{"parts":[{"text":"%s"}]}],"generationConfig":{"temperature":0.3,"maxOutputTokens":256}}' \
      "$(json_escape "$text_content")")
  fi
  
  local response
  response=$(curl -s "https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${GEMINI_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "$json_payload")
  
  if [ "$HAS_JQ" = true ]; then
    echo "$response" | jq -r '.candidates[0].content.parts[0].text // empty' 2>/dev/null
  else
    # Gemini retorna o texto em candidates[0].content.parts[0].text -> campo "text"
    parse_json_response "$response" "text"
  fi
}

generate_with_ollama() {
  local prompt="$1"
  local diff
  diff=$(get_staged_diff)
  
  # Modelo a usar (prefere llama3.2 se disponível, senão codellama)
  local model="llama3.2"
  if ! ollama list 2>/dev/null | grep -q "llama3.2"; then
    model="codellama"
  fi
  
  # Usa o prompt original (que já contém task_id/escopo) + instruções extras para modelos locais
  local full_prompt="Você é um gerador de mensagens de commit Git. Siga EXATAMENTE as instruções abaixo.

INSTRUÇÕES (SIGA COM PRECISÃO):
$prompt

REGRAS OBRIGATÓRIAS:
1. FORMATO EXATO: tipo(escopo): descrição
2. O ESCOPO deve ser EXATAMENTE o que foi especificado nas instruções acima (NÃO use o nome do arquivo)
3. Descrição deve começar com letra MINÚSCULA
4. NÃO usar ponto final
5. Máximo 72 caracteres
6. Retorne APENAS a mensagem, NADA MAIS

DIFF:
$diff

RESPOSTA (apenas a mensagem de commit):"

  # Usa a API REST do Ollama
  local json_payload
  if [ "$HAS_JQ" = true ]; then
    json_payload=$(jq -n \
      --arg model "$model" \
      --arg prompt "$full_prompt" \
      '{ model: $model, prompt: $prompt, stream: false }')
  else
    json_payload=$(printf '{"model":"%s","prompt":"%s","stream":false}' \
      "$model" \
      "$(json_escape "$full_prompt")")
  fi
  
  local response
  response=$(curl -s http://localhost:11434/api/generate \
    -H "Content-Type: application/json" \
    -d "$json_payload")
  
  if [ "$HAS_JQ" = true ]; then
    echo "$response" | jq -r '.response // empty' 2>/dev/null
  else
    parse_json_response "$response" "response"
  fi
}

generate_commit_message() {
  local prompt="$1"
  local output
  
  COMMITIA_RAW_OUTPUT=""
  
  case "$AI_PROVIDER" in
    amp)
      output=$(generate_with_amp "$prompt")
      ;;
    openai)
      output=$(generate_with_openai "$prompt")
      ;;
    gemini)
      output=$(generate_with_gemini "$prompt")
      ;;
    ollama)
      output=$(generate_with_ollama "$prompt")
      ;;
    cursor)
      output=$(generate_with_cursor "$prompt")
      ;;
    copilot)
      output=$(generate_with_copilot "$prompt")
      ;;
    claude)
      output=$(generate_with_claude "$prompt")
      ;;
    codex)
      output=$(generate_with_codex "$prompt")
      ;;
    gemini-cli)
      output=$(generate_with_gemini_cli "$prompt")
      ;;
  esac
  
  # Guarda a saída bruta (com ANSI/banners) para o log de erro
  COMMITIA_RAW_OUTPUT="$output"
  # generate_commit_message roda em subshell ($(...)); persiste a saída bruta em arquivo
  if [ -n "$COMMITIA_RAW_FILE" ]; then
    printf '%s' "$output" > "$COMMITIA_RAW_FILE"
  fi
  
  # Remove sequências ANSI (cores, cursor) e retornos de carro da saída das CLIs
  output=$(printf '%s\n' "$output" | perl -pe 's/\e\[[0-9;?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(\a|\e\\)//g; s/\r//g')
  
  # Extrai a mensagem no formato correto (ignora banners e outras linhas)
  local msg
  msg=$(echo "$output" | grep -oE '(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)\([^)]*\):.*' | head -1)
  
  # Limpa a mensagem:
  # 1. Remove espaços, ponto final, backticks, asteriscos (markdown)
  # 2. Converte primeira letra da descrição para minúscula
  echo "$msg" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\.$//;s/`//g;s/\*//g' | \
    perl -pe 's/^([^:]+:\s*)([A-Z])/$1\l$2/'
}

# ============================================================================
# Execução do commit
# ============================================================================

do_commit() {
  local message="$1"
  local amend_flag=""
  local tmp_stderr
  
  COMMITIA_COMMIT_STDERR=""
  
  if [ "$AMEND" = true ]; then
    amend_flag="--amend"
  fi
  
  tmp_stderr=$(mktemp)
  # shellcheck disable=SC2086
  set +e
  git commit $amend_flag -m "$message" 2>"$tmp_stderr"
  local ret=$?
  set -e
  COMMITIA_COMMIT_STDERR=$(cat "$tmp_stderr" 2>/dev/null)
  rm -f "$tmp_stderr"
  
  return $ret
}

# ============================================================================
# Arquivos grandes (lockfiles e diffs muito grandes)
# ============================================================================

# Verifica se o caminho casa com algum dos globs (separados por espaço/vírgula).
# Compara com o nome do arquivo (basename) e com o caminho completo.
matches_patterns() {
  local path="$1" patterns="$2" base pat
  base="${path##*/}"

  local old_ifs="$IFS"
  set -f
  IFS=$', \t\n'
  for pat in $patterns; do
    # shellcheck disable=SC2254
    case "$base" in
      $pat) set +f; IFS="$old_ifs"; return 0 ;;
    esac
    # shellcheck disable=SC2254
    case "$path" in
      $pat) set +f; IFS="$old_ifs"; return 0 ;;
    esac
  done
  set +f
  IFS="$old_ifs"
  return 1
}

# O arquivo é um lockfile conhecido? (usado no commit de último recurso)
is_lockfile() {
  matches_patterns "$1" "$DEFAULT_LOCKFILE_PATTERNS"
}

# O caminho está na lista de arquivos grandes detectados?
is_large_path() {
  local f
  for f in "${LARGE_FILES[@]}"; do
    [ "$f" = "$1" ] && return 0
  done
  return 1
}

# Detecta arquivos grandes no stage. Preenche LARGE_FILES (+ LARGE_REASONS e
# LARGE_BINARY em paralelo) e SMALL_FILES. Critérios (qualquer um):
#   - nome casa com COMMITIA_LARGE_FILE_PATTERNS (lockfiles por padrão);
#   - linhas alteradas (numstat) >= COMMITIA_LARGE_FILE_LINES;
#   - diff (ou binário) com bytes >= COMMITIA_LARGE_FILE_BYTES.
detect_large_files() {
  LARGE_FILES=()
  LARGE_REASONS=()
  LARGE_BINARY=()
  SMALL_FILES=()
  [ "$LARGE_FILES_ENABLED" = true ] || return 0

  # Passo 1: blobs (antigo/novo) de cada arquivo, para medir o tamanho em lote
  local meta path
  local -a parts r_paths=() r_blobs=() sizes=()
  while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
    read -ra parts <<< "$meta"
    r_paths+=("$path")
    r_blobs+=("${parts[2]}" "${parts[3]}")
  done < <(git diff --staged --raw -z --no-renames --no-abbrev 2>/dev/null)

  if [ "$LARGE_FILE_BYTES" -gt 0 ] && [ ${#r_blobs[@]} -gt 0 ]; then
    local line
    while IFS= read -r line; do
      case "$line" in
        *missing*) sizes+=(0) ;;
        *) sizes+=("$line") ;;
      esac
    done < <(printf '%s\n' "${r_blobs[@]}" | git cat-file --batch-check='%(objectsize)' 2>/dev/null)
  fi

  # Passo 2: numstat (linhas adicionadas/removidas; "-" = binário)
  local rec rest added deleted p reason is_bin lines maxsize diff_bytes i=0 s_old s_new
  while IFS= read -r -d '' rec; do
    added="${rec%%$'\t'*}"
    rest="${rec#*$'\t'}"
    deleted="${rest%%$'\t'*}"
    p="${rest#*$'\t'}"

    # Arquivo '+' do .commitiaignore: não vai à IA, então o tamanho não importa;
    # entra no commit "normal" (junto com os pequenos), sem commit separado
    if is_ai_excluded_path "$p"; then
      SMALL_FILES+=("$p")
      i=$((i + 1))
      continue
    fi

    is_bin=false
    [ "$added" = "-" ] && is_bin=true

    # Maior tamanho entre o blob antigo e o novo (0 se não medido)
    maxsize=0
    if [ "${r_paths[$i]}" = "$p" ] && [ ${#sizes[@]} -gt $((i * 2 + 1)) ]; then
      s_old="${sizes[$((i * 2))]}"
      s_new="${sizes[$((i * 2 + 1))]}"
      case "$s_old$s_new" in
        *[!0-9]*) ;;
        *)
          maxsize=$s_old
          [ "$s_new" -gt "$maxsize" ] && maxsize=$s_new
          ;;
      esac
    fi

    reason=""
    if matches_patterns "$p" "$LARGE_FILE_PATTERNS"; then
      reason="lockfile/padrão de arquivo grande"
    elif [ "$is_bin" = true ]; then
      if [ "$LARGE_FILE_BYTES" -gt 0 ] && [ "$maxsize" -ge "$LARGE_FILE_BYTES" ]; then
        reason="binário de $maxsize bytes"
      fi
    else
      lines=$((added + deleted))
      if [ "$LARGE_FILE_LINES" -gt 0 ] && [ "$lines" -ge "$LARGE_FILE_LINES" ]; then
        reason="diff com $lines linhas alteradas"
      elif [ "$LARGE_FILE_BYTES" -gt 0 ] && [ "$maxsize" -ge "$LARGE_FILE_BYTES" ]; then
        # Só mede o diff real dos candidatos (arquivo grande), para ser rápido
        diff_bytes=$(git diff --staged --no-renames -- ":(top,literal)$p" | wc -c | tr -d ' ')
        if [ "${diff_bytes:-0}" -ge "$LARGE_FILE_BYTES" ]; then
          reason="diff de $diff_bytes bytes"
        fi
      fi
    fi

    if [ -n "$reason" ]; then
      LARGE_FILES+=("$p")
      LARGE_BINARY+=("$is_bin")
      if [ "$is_bin" = true ]; then
        LARGE_REASONS+=("$reason; arquivo binário")
      else
        LARGE_REASONS+=("$reason; +$added -$deleted")
      fi
    else
      SMALL_FILES+=("$p")
    fi
    i=$((i + 1))
  done < <(git diff --staged --numstat -z --no-renames 2>/dev/null)

  return 0
}

# Descreve um commit (assunto, corpo curto e estatística resumida)
describe_commit() {
  local ref="${1:-HEAD}" head_part stat_part
  head_part=$(git log -1 --format='%h %s%n%b' "$ref" 2>/dev/null | head -n 8)
  [ -n "$head_part" ] || return 0
  stat_part=$(git show --stat --format= "$ref" 2>/dev/null | head -n 8)
  printf '%s\n%s' "$head_part" "$stat_part"
}

# Resumo da alteração para o fallback: nome do arquivo, linhas alteradas,
# cabeçalhos dos hunks, pequena amostra de linhas e o último commit da sessão
# (commit criado nesta execução do commitia; nunca o último commit da branch).
build_large_summary() {
  local -a files=()
  local f
  if [ ${#SCOPE_PATHS[@]} -gt 0 ]; then
    files=("${SCOPE_PATHS[@]}")
  else
    while IFS= read -r -d '' f; do
      files+=("$f")
    done < <(git diff --staged --name-only -z --no-renames 2>/dev/null)
  fi

  local out="" total=${#files[@]} shown=0 detail=0 line added deleted spec
  out="RESUMO DA ALTERAÇÃO (diff completo omitido por ser grande demais)"
  out+=$'\n'"Branch: $(git branch --show-current 2>/dev/null || echo '')"
  out+=$'\n'"Arquivos alterados: $total"

  for f in "${files[@]}"; do
    shown=$((shown + 1))
    if [ "$shown" -gt 40 ]; then
      out+=$'\n'"... e mais $((total - 40)) arquivo(s)"
      break
    fi
    # Arquivo '+' do .commitiaignore: só o nome (nem contagem de linhas nem amostras)
    if is_ai_excluded_path "$f"; then
      out+=$'\n'"- $f: alterado (conteúdo omitido por configuração do usuário em $IGNORE_FILE_NAME)"
      continue
    fi
    spec=":(top,literal)$f"
    line=$(git diff --staged --numstat --no-renames -- "$spec" 2>/dev/null | head -n 1)
    added="${line%%$'\t'*}"
    deleted="${line#*$'\t'}"
    deleted="${deleted%%$'\t'*}"

    if [ -z "$line" ]; then
      out+=$'\n'"- $f"
    elif [ "$added" = "-" ]; then
      out+=$'\n'"- $f: arquivo binário (sem contagem de linhas)"
    else
      out+=$'\n'"- $f: +$added -$deleted linhas alteradas"
      if is_large_path "$f" && [ "$detail" -lt 3 ]; then
        detail=$((detail + 1))
        out+=$'\n'"$(git diff --staged --no-renames --unified=0 -- "$spec" 2>/dev/null | awk -v maxh=15 -v maxl=20 '
          /^@@/ { seen = 1; nh++; if (nh <= maxh) { h = $0; if (length(h) > 160) h = substr(h, 1, 160); hunks[nh] = h } next }
          seen && /^[+-]/ {
            nc++
            if (nl < maxl) { l = $0; if (length(l) > 160) l = substr(l, 1, 160); lines[++nl] = l }
          }
          END {
            printf "  Hunks: %d\n", nh
            if (nh > 0) {
              print "  Cabeçalhos dos hunks (primeiros):"
              for (i = 1; i <= nh && i <= maxh; i++) print "    " hunks[i]
            }
            if (nl > 0) {
              printf "  Amostra das linhas alteradas (%d de %d):\n", nl, nc
              for (i = 1; i <= nl; i++) print "    " lines[i]
            }
          }')"
      fi
    fi
  done

  # Último commit da sessão (o fallback só roda quando ele existe)
  if [ -n "$SESSION_LAST_INFO" ]; then
    out+=$'\n\n'"${SESSION_LAST_LABEL}:"$'\n'"${SESSION_LAST_INFO}"
  fi

  # Limita o tamanho total do resumo
  if [ ${#out} -gt 8000 ]; then
    out="${out:0:8000}"$'\n'"... [resumo truncado]"
  fi
  printf '%s' "$out"
}

# Mensagem determinística de último recurso (a IA falhou mesmo com o resumo).
# Lockfiles: chore(deps): atualiza <lockfile>. Respeita tipo/escopo forçados e task id.
fallback_commit_message() {
  local -a files=()
  local f
  if [ ${#SCOPE_PATHS[@]} -gt 0 ]; then
    files=("${SCOPE_PATHS[@]}")
  else
    while IFS= read -r -d '' f; do
      files+=("$f")
    done < <(git diff --staged --name-only -z --no-renames 2>/dev/null)
  fi

  local type="${FORCED_TYPE:-chore}"
  local all_locks=true
  for f in "${files[@]}"; do
    is_lockfile "$f" || all_locks=false
  done
  [ ${#files[@]} -gt 0 ] || all_locks=false

  local scope
  if [ -n "$FORCED_SCOPE" ]; then
    scope="$FORCED_SCOPE"
  elif [ -n "$TASK_ID" ]; then
    scope="$TASK_ID"
  elif [ "$all_locks" = true ]; then
    scope="deps"
  elif [ ${#files[@]} -gt 0 ]; then
    f="${files[0]}"
    if [[ "$f" == */* ]]; then
      scope="${f%%/*}"
    else
      scope="${f##*/}"
      scope="${scope%.*}"
      [ -n "$scope" ] || scope="${f##*/}"
    fi
    scope=$(printf '%s' "$scope" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-\n' '-')
    scope="${scope#-}"
    scope="${scope%-}"
  fi
  [ -n "$scope" ] || scope="arquivos"

  local verb files_word
  case "$LANGUAGE" in
    en) verb="update"; files_word="files" ;;
    es) verb="actualiza"; files_word="archivos" ;;
    *) verb="atualiza"; files_word="arquivos" ;;
  esac

  if [ ${#files[@]} -eq 1 ]; then
    echo "$type($scope): $verb ${files[0]##*/}"
  else
    echo "$type($scope): $verb ${#files[@]} $files_word"
  fi
}

# Devolve um arquivo ao stage exatamente como estava no stage original
# (usa a árvore salva em SAVED_TREE; preserva staging parcial e remoções)
restore_path_to_stage() {
  local path="$1" rec mode_type_sha mode sha
  local -a fields=()

  rec=""
  IFS= read -r -d '' rec < <(git -C "$GIT_ROOT" ls-tree --full-tree -z "$SAVED_TREE" -- "$path" 2>/dev/null) || true

  if [ -n "$rec" ] && [ "${rec#*$'\t'}" = "$path" ]; then
    mode_type_sha="${rec%%$'\t'*}"
    read -ra fields <<< "$mode_type_sha"
    mode="${fields[0]}"
    sha="${fields[2]}"
    git -C "$GIT_ROOT" update-index --add --cacheinfo "$mode,$sha,$path"
  else
    # Não existia na árvore salva: era uma remoção staged
    git -C "$GIT_ROOT" update-index --force-remove -- "$path"
  fi
}

# Tira arquivos do stage (mantém as alterações no diretório de trabalho)
unstage_paths() {
  local -a specs=()
  local f
  for f in "$@"; do
    specs+=(":(top,literal)$f")
  done
  git reset -q -- "${specs[@]}" >/dev/null 2>&1 || true
}

# Remove um arquivo da lista de pendentes
remove_pending() {
  local target="$1" f
  local -a rest=()
  for f in "${PENDING_FILES[@]}"; do
    [ "$f" = "$target" ] || rest+=("$f")
  done
  PENDING_FILES=("${rest[@]}")
}

# Devolve ao stage os arquivos grandes ainda não commitados (falha, cancelamento
# ou interrupção), para que nada se perca. Idempotente.
restore_pending_files() {
  [ ${#PENDING_FILES[@]} -gt 0 ] || return 0

  local f
  local -a to_restore=("${PENDING_FILES[@]}")
  PENDING_FILES=()
  for f in "${to_restore[@]}"; do
    restore_path_to_stage "$f" 2>/dev/null || true
  done
  warn "Arquivos grandes devolvidos ao stage (não commitados): ${to_restore[*]}" || true
  return 0
}

# ============================================================================
# Geração + commit de um grupo (todo o stage ou o escopo atual)
# ============================================================================

# Tenta gerar a mensagem com a IA para o prompt dado.
# Define COMMIT_MSG e COMMITIA_RAW_OUTPUT.
ai_attempt() {
  local prompt="$1"
  COMMITIA_RAW_FILE=$(mktemp)
  COMMIT_MSG=$(generate_commit_message "$prompt") || COMMIT_MSG=""
  COMMITIA_RAW_OUTPUT=$(cat "$COMMITIA_RAW_FILE" 2>/dev/null || true)
  rm -f "$COMMITIA_RAW_FILE"
}

# Grava o log de uma falha da IA e registra na sessão (para não ser apagado
# pelo clear_error_logs). Define LOG_PATH.
log_ai_failure() {
  local prompt="$1" diff_content="$2"
  LOG_PATH=$(write_error_log \
    "$COMMITIA_RAW_OUTPUT" \
    "$prompt" \
    "$diff_content" \
    "$(get_staged_files)" \
    "$(git branch --show-current 2>/dev/null || echo '')")
  SESSION_LOGS+=("$LOG_PATH")
}

# Gera a mensagem e comita o grupo atual.
# $1: allow_fallback (true = tenta resumo e depois mensagem de último recurso)
# $2: skip_full (true = não envia o diff completo, ex.: arquivo binário)
# Retorno: 0 = ok (ou dry-run), 1 = erro, 2 = cancelado pelo usuário
commit_staged_group() {
  local allow_fallback="${1:-false}"
  local skip_full="${2:-false}"

  # Contexto para a IA (-m do usuário + dica de lockfile)
  local ctx="$CONTEXT_MSG"
  if [ -n "$GROUP_HINT" ] && [ -z "$FORCED_TYPE" ]; then
    if [ -n "$ctx" ]; then ctx="$ctx. $GROUP_HINT"; else ctx="$GROUP_HINT"; fi
  fi

  MSG_SOURCE="ia"
  DIFF_MODE="full"
  COMMIT_MSG=""
  local prompt

  if staged_group_fully_ai_excluded; then
    # Todos os arquivos do commit são '+' no .commitiaignore: não há nada a enviar à IA
    info "Todos os arquivos deste commit estão marcados com '+' no $IGNORE_FILE_NAME: nada é enviado à IA"
    COMMIT_MSG=$(fallback_commit_message)
    MSG_SOURCE="ignorado"
  elif [ "$skip_full" = true ]; then
    info "Arquivo binário: o diff não será enviado, apenas um resumo"
  else
    prompt=$(build_prompt "$TASK_ID" "$ctx" "$FORCED_TYPE" "$FORCED_SCOPE" "$LANGUAGE" full)
    info "Gerando mensagem com IA ($AI_PROVIDER)..."
    ai_attempt "$prompt"

    if [ -z "$COMMIT_MSG" ]; then
      log_ai_failure "$prompt" "$(get_staged_diff)"
      # CLI desatualizada (flag desconhecida): avisa e aborta, sem usar fallback
      if report_cli_outdated_failure; then
        return 1
      fi
      if [ "$allow_fallback" != true ]; then
        echo ""
        echo -e "${RED}✗ Erro: Não foi possível gerar a mensagem de commit${NC}" >&2
        echo -e "  Log gravado em: ${BOLD}$LOG_PATH${NC}" >&2
        return 1
      fi
      warn "A IA falhou com o diff completo (log: $LOG_PATH)"
    fi
  fi

  # Sem commit criado nesta sessão não há contexto para o fallback com a IA
  # (o último commit da branch NÃO é usado): vai direto ao último recurso
  if [ -z "$COMMIT_MSG" ] && [ -z "$SESSION_LAST_INFO" ]; then
    info "Nenhum commit nesta sessão do commitia: indo direto para a mensagem de último recurso"
    COMMIT_MSG=$(fallback_commit_message)
    MSG_SOURCE="minimo"
  fi

  # Fallback 1: somente nome, linhas alteradas, contexto resumido e último commit
  # da sessão (commits criados nesta execução do commitia)
  if [ -z "$COMMIT_MSG" ]; then
    COMMITIA_SUMMARY=$(build_large_summary)
    DIFF_MODE="summary"
    info "Fallback: enviando à IA apenas nome do arquivo, linhas alteradas e contexto resumido..."
    prompt=$(build_prompt "$TASK_ID" "$ctx" "$FORCED_TYPE" "$FORCED_SCOPE" "$LANGUAGE" summary)
    ai_attempt "$prompt"

    if [ -n "$COMMIT_MSG" ]; then
      MSG_SOURCE="resumo"
    else
      log_ai_failure "$prompt" "$COMMITIA_SUMMARY"
      # CLI desatualizada: avisa e aborta em vez de cair no último recurso
      if report_cli_outdated_failure; then
        DIFF_MODE="full"
        return 1
      fi
      warn "A IA também falhou com o resumo (log: $LOG_PATH)"
      # Fallback 2 (último recurso): mensagem determinística
      COMMIT_MSG=$(fallback_commit_message)
      MSG_SOURCE="minimo"
    fi
    DIFF_MODE="full"
  fi

  echo ""
  echo -e "${BOLD}Mensagem gerada:${NC}"
  echo -e "  ${GREEN}$COMMIT_MSG${NC}"
  case "$MSG_SOURCE" in
    resumo) info "Mensagem gerada pelo fallback (nome, linhas alteradas e contexto resumido)" ;;
    minimo) warn "A IA falhou; usada mensagem padrão de último recurso" ;;
    ignorado) info "Mensagem padrão: o conteúdo dos arquivos deste commit não é enviado à IA ($IGNORE_FILE_NAME)" ;;
  esac
  echo ""

  # Dry run
  if [ "$DRY_RUN" = true ]; then
    info "Modo dry-run: commit não realizado"
    SESSION_LAST_INFO="$COMMIT_MSG (simulado: dry-run)"
    SESSION_LAST_LABEL="Último commit desta sessão do commitia (simulado)"
    return 0
  fi

  # Modo interativo
  if [ "$INTERACTIVE" = true ]; then
    echo -e "${YELLOW}Deseja realizar o commit? [S/n/e]${NC}"
    echo "  S - Sim, realizar commit"
    echo "  n - Não, cancelar"
    echo "  e - Editar mensagem"
    read -r -n 1 response
    echo ""

    case $response in
      [Nn])
        info "Commit cancelado"
        return 2
        ;;
      [Ee])
        echo -e "${YELLOW}Digite a nova mensagem:${NC}"
        read -r COMMIT_MSG
        ;;
    esac
  fi

  # Realiza o commit
  if do_commit "$COMMIT_MSG"; then
    clear_error_logs
    SESSION_LAST_COMMIT=$(git rev-parse HEAD 2>/dev/null || echo "")
    SESSION_LAST_INFO=$(describe_commit HEAD)
    SESSION_LAST_LABEL="Último commit feito nesta sessão do commitia"
    success "Commit realizado: $COMMIT_MSG"
    return 0
  fi

  LOG_PATH=$(write_commit_failure_log \
    "$COMMIT_MSG" \
    "$COMMITIA_COMMIT_STDERR" \
    "$(get_staged_files)" \
    "$(git branch --show-current 2>/dev/null || echo '')")
  echo ""
  echo -e "${RED}✗ Erro: Falha ao realizar commit${NC}" >&2
  echo -e "  Log gravado em: ${BOLD}$LOG_PATH${NC}" >&2
  return 1
}

# Fluxo com arquivos grandes: primeiro os pequenos, depois cada arquivo grande
# em um commit separado. Retorno: 0 = ok, 1 = erro, 2 = cancelado.
run_large_files_flow() {
  local nl=${#LARGE_FILES[@]} ns=${#SMALL_FILES[@]}
  local i f rc step=0 steps

  steps=$nl
  [ "$ns" -gt 0 ] && steps=$((steps + 1))

  echo -e "${YELLOW}⚠ Arquivos grandes detectados (serão commitados separadamente):${NC}"
  for ((i = 0; i < nl; i++)); do
    echo -e "  ${CYAN}→${NC} ${LARGE_FILES[$i]} (${LARGE_REASONS[$i]})"
  done
  if [ "$ns" -gt 0 ]; then
    info "Primeiro serão commitados os $ns arquivo(s) pequeno(s); depois cada arquivo grande, em commit próprio ($steps commits no total)"
  else
    info "Cada arquivo grande será commitado separadamente ($steps commit(s))"
  fi
  [ "$DRY_RUN" = true ] && info "Modo dry-run: o stage não será alterado"
  echo ""

  DIFF_TRUNCATE=true

  # Só é preciso mexer no stage se houver mais de um commit a fazer
  local need_split=false
  if [ "$ns" -gt 0 ] || [ "$nl" -gt 1 ]; then need_split=true; fi

  if [ "$need_split" = true ] && [ "$DRY_RUN" != true ]; then
    GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
    SAVED_TREE=$(git write-tree 2>/dev/null) || SAVED_TREE=""
    if [ -z "$GIT_ROOT" ] || [ -z "$SAVED_TREE" ]; then
      warn "Não foi possível salvar o estado do stage (merge/conflito em andamento?); commitando tudo junto"
      clear_scope
      rc=0
      commit_staged_group true false || rc=$?
      DIFF_TRUNCATE=false
      return $rc
    fi

    # Qualquer saída (erro, Ctrl+C) devolve os arquivos grandes ao stage
    trap 'restore_pending_files' EXIT
    trap 'restore_pending_files; exit 130' INT TERM

    PENDING_FILES=("${LARGE_FILES[@]}")
    unstage_paths "${LARGE_FILES[@]}"

    # Garante que nenhum arquivo grande ficou no stage antes do commit dos pequenos
    set_scope "${LARGE_FILES[@]}"
    if [ -n "$(get_staged_files)" ]; then
      clear_scope
      restore_pending_files
      error "Não foi possível separar os arquivos grandes do stage"
    fi
  fi

  # 1) Arquivos pequenos
  if [ "$ns" -gt 0 ]; then
    step=$((step + 1))
    set_scope "${SMALL_FILES[@]}"
    GROUP_HINT=""
    info "[$step/$steps] Commitando os arquivos pequenos ($ns)..."
    for f in "${SMALL_FILES[@]}"; do
      echo -e "  ${CYAN}→${NC} $f"
    done
    echo ""
    rc=0
    commit_staged_group false false || rc=$?
    if [ "$rc" -ne 0 ]; then
      restore_pending_files
      clear_scope
      DIFF_TRUNCATE=false
      return $rc
    fi
  fi

  # 2) Cada arquivo grande em commit separado
  for ((i = 0; i < nl; i++)); do
    f="${LARGE_FILES[$i]}"
    step=$((step + 1))

    # Devolve este arquivo ao stage (estado original) antes de comitá-lo
    if [ "$DRY_RUN" != true ] && [ ${#PENDING_FILES[@]} -gt 0 ]; then
      restore_path_to_stage "$f"
      remove_pending "$f"
    fi

    set_scope "$f"
    GROUP_HINT=""
    if is_lockfile "$f"; then
      GROUP_HINT="alteração em arquivo de dependências (lockfile); prefira o tipo 'build' ou 'chore'"
    fi

    echo ""
    info "[$step/$steps] Commitando arquivo grande: ${BOLD}$f${NC}"
    rc=0
    commit_staged_group true "${LARGE_BINARY[$i]}" || rc=$?
    if [ "$rc" -ne 0 ]; then
      restore_pending_files
      clear_scope
      DIFF_TRUNCATE=false
      return $rc
    fi
  done

  clear_scope
  DIFF_TRUNCATE=false
  trap - EXIT INT TERM

  if [ ${#SESSION_LOGS[@]} -gt 0 ]; then
    info "Logs das falhas intermediárias da IA mantidos em: $(get_log_dir)"
  fi
  return 0
}

# ============================================================================
# Skill para agentes de IA (commitia skill)
#
# Gera uma "Agent Skill" (SKILL.md) que ensina agentes de IA a usar o commitia
# para commitar. O mesmo arquivo serve ao Cursor, ao VS Code/GitHub Copilot e
# ao Claude Code (formato aberto: frontmatter YAML + instruções em Markdown).
# ============================================================================

SKILL_NAME="commitia"
SKILL_DEFAULT_FILE="commitia-skill.md"

# Conteúdo da skill (em stdout). Versão do commitia gravada para facilitar a atualização.
print_skill_content() {
  cat <<'EOF_FRONT'
---
name: commitia
description: "Cria commits Git com mensagem no padrão Conventional Commits gerada por IA, usando a CLI `commitia`. Use sempre que o usuário pedir para commitar, fazer commit, salvar alterações no Git ou gerar a mensagem de um commit."
---
EOF_FRONT
  printf '<!-- Gerada pelo commitia v%s (commitia skill). Para atualizar: commitia skill <destino> --force -->\n' "$VERSION"
  cat <<'EOF_BODY'

# Commits com o CommitIA

O `commitia` é uma CLI que lê o diff do stage do Git, gera a mensagem de commit com IA
(padrão [Conventional Commits](https://www.conventionalcommits.org/)) e executa o `git commit`.
**Para commitar neste projeto, use o `commitia` em vez de escrever a mensagem manualmente.**

## Quando usar

- O usuário pediu para "commitar", "fazer commit", "salvar no git" ou "gerar mensagem de commit".
- Você terminou uma tarefa e o usuário pediu que as alterações fossem commitadas.

Não faça `git push`, não crie branches e não use `--amend` a menos que o usuário peça.

## Pré-requisitos

- Dentro de um repositório Git e com a CLI instalada: `commitia --version`.
- Um provedor de IA configurado (`COMMITIA_PROVIDER` em `.commitiarc` ou `~/.commitiarc`).
  Se o comando falhar por falta de provedor/login, informe o usuário em vez de contornar.

## Fluxo recomendado

1. Entenda o que mudou: `git status --short` e `git diff`.
2. Coloque no stage **somente** os arquivos que pertencem a este commit:
   `git add <arquivo1> <arquivo2>`.
3. Commite o que está no stage, sem adicionar mais nada:

   ```bash
   commitia --no-stage
   ```

   Para dar contexto do porquê da mudança (a mensagem continua sendo gerada a partir do diff):

   ```bash
   commitia --no-stage -m "corrige falha de autenticação ao expirar o token"
   ```

4. Confira o resultado: `git log -1 --stat`.

Se houver várias mudanças independentes, faça **um commit por assunto**: repita os passos 2 e 3
para cada grupo de arquivos.

> Sem `--no-stage` e sem arquivos informados, o commitia usa o que já está no stage; se o stage
> estiver vazio, executa `git add .` e inclui **tudo** (inclusive arquivos novos não relacionados).
> Por isso prefira a abordagem acima, com stage explícito.

### Atalhos

| Comando | O que faz |
| --- | --- |
| `commitia` | Commita o stage; se vazio, adiciona tudo (`git add .`) e commita |
| `commitia src/ README.md` | Adiciona esses caminhos ao stage e commita (o que já estava no stage também entra) |
| `commitia --no-stage` | Commita apenas o que já está no stage (erro se estiver vazio) |
| `commitia -d` | Dry-run: mostra a mensagem que seria usada, sem commitar |

## Opções

| Opção | Descrição |
| --- | --- |
| `-m, --message <texto>` | Contexto adicional para a IA (o motivo da mudança) |
| `-t, --type <tipo>` | Força o tipo: `feat`, `fix`, `docs`, `style`, `refactor`, `test`, `chore`, `perf`, `ci`, `build`, `revert` |
| `-s, --scope <escopo>` | Define o escopo manualmente |
| `-d, --dry-run` | Só mostra a mensagem, sem commitar |
| `-a, --amend` | Altera o último commit (só se o usuário pedir) |
| `--no-stage` | Não adiciona arquivos ao stage automaticamente |
| `--provider <nome>` | Provedor de IA: `amp`, `openai`, `gemini`, `ollama`, `cursor`, `copilot`, `claude`, `codex`, `gemini-cli` |
| `--lang <pt\|en\|es>` | Idioma da mensagem |
| `-i, --interactive` | **Não use**: pede confirmação pelo teclado e trava em ambientes sem terminal |
| `--update`, `--force` | Atualiza o commitia (só se o usuário pedir) |

Exemplos:

```bash
commitia --no-stage -t fix -s auth -m "evita logout indevido"
commitia --no-stage --lang en
commitia -d --no-stage        # pré-visualiza a mensagem
```

## Mensagem gerada

- Formato `tipo(escopo): descrição`, descrição curta, em minúscula e sem ponto final.
- O escopo é detectado da branch quando ela tem um ID de tarefa (`feature/ENP-1234-algo` →
  `ENP-1234`); caso contrário a IA infere dos arquivos. `-s` sobrescreve.
- O idioma vem de `COMMITIA_LANGUAGE` (padrão `pt`) ou de `--lang`.

## Arquivos grandes

Lockfiles (`pnpm-lock.yaml`, `package-lock.json`, `yarn.lock`, `Cargo.lock`...) e diffs enormes são
commitados automaticamente em **commits separados**: primeiro os arquivos pequenos, depois cada
arquivo grande. Se a IA falhar nesses arquivos, o commitia usa um fallback e, em último caso, uma
mensagem padrão (`chore(deps): atualiza <arquivo>`). Você não precisa tratar isso manualmente
(com `--amend` não há separação).

## Tratando erros

- O comando termina com código diferente de 0 quando falha. Leia a saída antes de tentar de novo.
- Falhas da IA e de hooks (commitlint, husky, pre-commit) geram logs em `.commitia/logs/`
  (o caminho aparece na saída). Corrija a causa e rode o commitia novamente.
- `Não há alterações para commitar` / `no stage`: nada a commitar ou nada no stage; confira com `git status`.
- `a CLI '...' precisa ser atualizada`: a CLI do provedor está desatualizada; informe o usuário
  (o comando de atualização aparece na saída) ou use `--provider` com outro provedor.
- Aviso de nova versão do commitia: fora de terminal ele apenas informa. Não atualize por conta
  própria; para silenciar use `COMMITIA_SKIP_UPDATE_CHECK=true`.
- Só escreva a mensagem manualmente (`git commit -m "tipo(escopo): descrição"`) se o commitia
  estiver indisponível ou o usuário pedir, mantendo o padrão Conventional Commits.

## Configuração

Ordem de prioridade: linha de comando > `.commitiarc` na raiz do projeto > `~/.commitiarc` > padrões.
O arquivo é um script shell com variáveis, por exemplo:

```bash
COMMITIA_PROVIDER="claude"
COMMITIA_LANGUAGE="pt"
COMMITIA_AUTO_STAGE="true"
COMMITIA_LARGE_FILES="true"
```

Não altere esses arquivos sem o usuário pedir.
EOF_BODY
}

print_skill_help() {
  echo -e "${BOLD}USO:${NC}"
  echo "  $SCRIPT_NAME skill [destino...] [opções]"
  echo ""
  echo "  Gera uma skill (SKILL.md) que ensina agentes de IA a usar o commitia para commitar."
  echo ""
  echo -e "${BOLD}DESTINOS:${NC}"
  echo "  cursor     Cursor          (.cursor/skills/commitia/SKILL.md)"
  echo "  vscode     VS Code         (.github/skills/commitia/SKILL.md)"
  echo "  copilot    GitHub Copilot  (.github/skills/commitia/SKILL.md; global: ~/.copilot/skills)"
  echo "  claude     Claude Code     (.claude/skills/commitia/SKILL.md)"
  echo "  file       Apenas gera o arquivo, para você incluir onde preferir (padrão: ./$SKILL_DEFAULT_FILE)"
  echo ""
  echo "  Sem destino, em terminal interativo, o commitia pergunta onde instalar."
  echo "  Você pode informar vários destinos: $SCRIPT_NAME skill cursor copilot"
  echo ""
  echo -e "${BOLD}OPÇÕES:${NC}"
  echo "  -g, --global           Instala no diretório do usuário (vale para todos os projetos)"
  echo "  -o, --output <caminho> Com 'file': arquivo de saída ('-' imprime na tela)"
  echo "  --force                Sobrescreve uma skill existente diferente"
  echo "  -d, --dry-run          Mostra o que seria gravado, sem criar arquivos"
  echo "  -h, --help             Mostra esta ajuda"
  echo ""
  echo -e "${BOLD}EXEMPLOS:${NC}"
  echo "  $SCRIPT_NAME skill cursor              # skill do projeto atual, para o Cursor"
  echo "  $SCRIPT_NAME skill copilot --global    # skill pessoal do GitHub Copilot"
  echo "  $SCRIPT_NAME skill file -o -           # imprime a skill na tela"
  echo "  $SCRIPT_NAME skill file -o docs/ia/SKILL.md"
  echo ""
}

# Normaliza o nome do destino (retorna 1 se for inválido)
normalize_skill_target() {
  case "$1" in
    cursor) echo "cursor" ;;
    vscode|vs-code|code) echo "vscode" ;;
    copilot|github|github-copilot) echo "copilot" ;;
    claude|claude-code) echo "claude" ;;
    file|arquivo|print) echo "file" ;;
    *) return 1 ;;
  esac
}

# Raiz do projeto: raiz do repositório Git ou, fora de um, o diretório atual
skill_project_root() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
  [ -n "$root" ] || root="$PWD"
  printf '%s' "$root"
}

# Diretório "skills" do destino. $1: destino; $2: true = global (home do usuário)
skill_base_dir() {
  local target="$1" global="$2" rel_project rel_global
  case "$target" in
    cursor)  rel_project=".cursor/skills";  rel_global=".cursor/skills" ;;
    vscode)  rel_project=".github/skills";  rel_global=".copilot/skills" ;;
    copilot) rel_project=".github/skills";  rel_global=".copilot/skills" ;;
    claude)  rel_project=".claude/skills";  rel_global=".claude/skills" ;;
    *) return 1 ;;
  esac
  if [ "$global" = true ]; then
    printf '%s/%s' "$HOME" "$rel_global"
  else
    printf '%s/%s' "$(skill_project_root)" "$rel_project"
  fi
}

# Grava a skill em $1 (arquivo). Retorna 0 em sucesso (inclusive "já atualizada")
# e 1 se já existe um arquivo diferente e --force não foi usado.
write_skill_file() {
  local dest="$1" force="$2" dry="$3" tmp

  tmp=$(mktemp) || error "Não foi possível criar arquivo temporário"
  print_skill_content > "$tmp"

  if [ -e "$dest" ] && cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"
    success "Skill já está atualizada: $dest"
    return 0
  fi

  if [ -e "$dest" ] && [ "$force" != true ]; then
    rm -f "$tmp"
    warn "Já existe uma skill diferente em: $dest (use --force para sobrescrever)"
    return 1
  fi

  if [ "$dry" = true ]; then
    rm -f "$tmp"
    info "Modo dry-run: gravaria a skill em $dest"
    return 0
  fi

  if ! mkdir -p "$(dirname "$dest")" 2>/dev/null || ! cp "$tmp" "$dest" 2>/dev/null; then
    rm -f "$tmp"
    error "Não foi possível gravar a skill em $dest. Verifique as permissões."
  fi
  rm -f "$tmp"
  success "Skill gravada em: $dest"
  return 0
}

# Pergunta (menu numerado) onde instalar. Define SKILL_TARGETS e, se aplicável, SKILL_GLOBAL.
# Retorna 1 se não for possível perguntar ou a resposta for inválida.
prompt_skill_targets() {
  is_interactive_terminal || return 1

  echo -e "${BOLD}Onde deseja criar a skill do commitia?${NC}"
  echo "  1) Cursor"
  echo "  2) VS Code"
  echo "  3) GitHub Copilot"
  echo "  4) Claude Code"
  echo "  5) Apenas gerar o arquivo (para incluir onde preferir)"
  echo -n "Opção [1-5]: "
  local choice=""
  read -r choice || true
  case "$choice" in
    1) SKILL_TARGETS+=("cursor") ;;
    2) SKILL_TARGETS+=("vscode") ;;
    3) SKILL_TARGETS+=("copilot") ;;
    4) SKILL_TARGETS+=("claude") ;;
    5) SKILL_TARGETS+=("file"); return 0 ;;
    *) warn "Opção inválida: '$choice'"; return 1 ;;
  esac

  if [ "$SKILL_GLOBAL" != true ]; then
    echo -e "${BOLD}Escopo da skill:${NC}"
    echo "  1) Somente este projeto"
    echo "  2) Todos os projetos (global, no seu usuário)"
    echo -n "Opção [1-2]: "
    local scope=""
    read -r scope || true
    [ "$scope" = "2" ] && SKILL_GLOBAL=true
  fi
  return 0
}

# Subcomando: commitia skill [destino...] [opções]
do_skill() {
  SKILL_TARGETS=()
  SKILL_GLOBAL=false
  local force=false dry=false output="" arg normalized

  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      -h|--help)
        print_banner
        print_skill_help
        return 0
        ;;
      -g|--global) SKILL_GLOBAL=true; shift ;;
      --force) force=true; shift ;;
      -d|--dry-run) dry=true; shift ;;
      -o|--output)
        [ $# -ge 2 ] || error "A opção $arg exige um caminho (ou '-' para imprimir na tela)"
        output="$2"
        shift 2
        ;;
      -*) error "Opção desconhecida para 'skill': $arg (veja: $SCRIPT_NAME skill --help)" ;;
      *)
        normalized=$(normalize_skill_target "$arg") || \
          error "Destino desconhecido: $arg (use: cursor, vscode, copilot, claude ou file)"
        SKILL_TARGETS+=("$normalized")
        shift
        ;;
    esac
  done

  if [ ${#SKILL_TARGETS[@]} -eq 0 ]; then
    if ! prompt_skill_targets; then
      echo "" >&2
      echo -e "${RED}✗ Erro: informe o destino da skill${NC}" >&2
      echo "  Uso: $SCRIPT_NAME skill <cursor|vscode|copilot|claude|file> [--global]" >&2
      echo "  Ajuda: $SCRIPT_NAME skill --help" >&2
      return 1
    fi
  fi

  local target dest rc=0 had_file=false
  for target in "${SKILL_TARGETS[@]}"; do
    if [ "$target" = "file" ]; then
      had_file=true
      dest="${output:-./$SKILL_DEFAULT_FILE}"
      if [ "$dest" = "-" ]; then
        print_skill_content
        continue
      fi
      write_skill_file "$dest" "$force" "$dry" || rc=1
    else
      dest="$(skill_base_dir "$target" "$SKILL_GLOBAL")/$SKILL_NAME/SKILL.md"
      write_skill_file "$dest" "$force" "$dry" || rc=1
    fi
  done

  if [ -n "$output" ] && [ "$had_file" != true ]; then
    warn "A opção --output só vale com o destino 'file'"
  fi
  return $rc
}

# ============================================================================
# Main
# ============================================================================

main() {
  ORIG_ARGS=("$@")

  # Subcomando 'skill' (só quando é o primeiro argumento; para commitar um
  # arquivo chamado "skill", use ./skill)
  if [ "${1:-}" = "skill" ]; then
    shift
    do_skill "$@"
    exit $?
  fi

  # Parse de argumentos
  FILES=()
  CONTEXT_MSG=""
  FORCED_TYPE=""
  FORCED_SCOPE=""
  
  # Variáveis CLI (prioridade sobre config)
  CLI_PROVIDER=""
  CLI_LANGUAGE=""
  CLI_AUTO_STAGE=""
  DO_UPDATE=false
  
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help)
        print_help
        exit 0
        ;;
      -v|--version)
        print_version
        exit 0
        ;;
      --update)
        DO_UPDATE=true
        shift
        ;;
      --force)
        FORCE_UPDATE=true
        shift
        ;;
      -m|--message)
        CONTEXT_MSG="$2"
        shift 2
        ;;
      -t|--type)
        FORCED_TYPE="$2"
        shift 2
        ;;
      -s|--scope)
        FORCED_SCOPE="$2"
        shift 2
        ;;
      -i|--interactive)
        INTERACTIVE=true
        shift
        ;;
      -d|--dry-run)
        DRY_RUN=true
        shift
        ;;
      -a|--amend)
        AMEND=true
        shift
        ;;
      --no-stage)
        CLI_AUTO_STAGE=false
        shift
        ;;
      --provider)
        CLI_PROVIDER="$2"
        shift 2
        ;;
      --lang)
        CLI_LANGUAGE="$2"
        shift 2
        ;;
      -*)
        error "Opção desconhecida: $1"
        ;;
      *)
        FILES+=("$1")
        shift
        ;;
    esac
  done
  
  # Executa update se solicitado
  if [ "$DO_UPDATE" = true ]; then
    do_update
    exit 0
  fi
  
  # Carrega configuração
  load_config
  
  # Nova versão do commitia? (antes de validar CLIs e de gerar/aplicar o commit)
  check_self_update

  # Verificações
  check_dependencies

  # Regras do .commitiaignore (opcional): o que não é adicionado sozinho / não vai à IA
  load_ignore_rules
  
  # Stage de arquivos
  if [ "$AUTO_STAGE" = true ]; then
    if [ ${#FILES[@]} -eq 0 ]; then
      if ! check_staged_changes; then
        if check_unstaged_changes; then
          info "Adicionando todas as alterações ao stage..."
          stage_changes
        else
          error "Não há alterações para commitar"
        fi
      fi
    else
      info "Adicionando arquivos ao stage: ${FILES[*]}"
      stage_changes "${FILES[@]}"
    fi
  fi

  # Arquivos que o .commitiaignore (sem prefixo) impediu de adicionar automaticamente
  if [ ${#IGNORE_SKIPPED[@]} -gt 0 ]; then
    info "Não adicionados automaticamente ($IGNORE_FILE_NAME, sem prefixo; use 'git add <arquivo>' para incluí-los):"
    for file in "${IGNORE_SKIPPED[@]}"; do
      echo -e "  ${YELLOW}⊘${NC} $file"
    done
  fi
  
  # Verifica se há alterações staged
  if ! check_staged_changes; then
    if [ ${#IGNORE_SKIPPED[@]} -gt 0 ]; then
      error "Não há alterações no stage para commitar (os arquivos alterados estão no $IGNORE_FILE_NAME)"
    fi
    error "Não há alterações no stage para commitar"
  fi
  
  # Mostra arquivos que serão commitados
  echo ""
  info "Arquivos no stage:"
  get_staged_files | while read -r file; do
    if is_ai_excluded_path "$file"; then
      echo -e "  ${CYAN}→${NC} $file ${YELLOW}(commitado; conteúdo não enviado à IA)${NC}"
    else
      echo -e "  ${CYAN}→${NC} $file"
    fi
  done
  echo ""
  
  # Obtém task ID da branch
  TASK_ID=$(get_task_id_from_branch)
  if [ -n "$TASK_ID" ]; then
    info "Task ID detectado: ${BOLD}$TASK_ID${NC}"
  fi
  
  # Detecta arquivos grandes (lockfiles, diffs muito grandes, binários grandes)
  detect_large_files
  
  local rc=0
  if [ ${#LARGE_FILES[@]} -eq 0 ]; then
    # Fluxo padrão: um único commit com todo o stage
    commit_staged_group false false || rc=$?
  elif [ "$AMEND" = true ]; then
    # --amend: não há como separar em vários commits; usa só o fallback da mensagem
    warn "--amend: arquivos grandes (${LARGE_FILES[*]}) não serão separados; o fallback de mensagem continua ativo"
    DIFF_TRUNCATE=true
    commit_staged_group true false || rc=$?
  else
    run_large_files_flow || rc=$?
  fi
  
  case $rc in
    1) exit 1 ;;
  esac
}

# Executa
main "$@"

